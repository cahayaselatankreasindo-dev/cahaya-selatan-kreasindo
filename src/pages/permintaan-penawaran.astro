---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Section from '../components/Section.astro';
import LeadInquiryForm from '../components/LeadInquiryForm.astro';

const crumbs = [
  { href: '/permintaan-penawaran/', label: 'Permintaan Penawaran' },
];
---
<Base
  title="Minta Penawaran Booth, POSM & Rak Display"
  description="Kirim kebutuhan booth pameran, POSM, rak display, neon box, dan signage kepada Cahaya Selatan Kreasindo. Tim kami akan meninjau brief dan menghubungi Anda."
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />
  <Section as="h1" eyebrow="Permintaan proyek" title="Mulai konsultasi dan minta penawaran"
    lead="Ceritakan kebutuhan produksi brand atau bisnis Anda. Tim CSK akan meninjau spesifikasi, jumlah, lokasi, dan target waktu sebelum menyiapkan langkah berikutnya.">
    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
      <LeadInquiryForm />
      <aside class="space-y-4">
        <div class="rounded-2xl border border-csk-gray/15 bg-white p-6">
          <h2 class="text-base font-semibold text-csk-black">Butuh respons lebih cepat?</h2>
          <p class="mt-2 text-sm leading-relaxed text-csk-gray">Hubungi tim kami melalui WhatsApp pada jam operasional. Anda bisa mengirim foto lokasi atau referensi desain melalui chat.</p>
          <a href="https://wa.me/628888533488?text=Halo%20CSK%2C%20saya%20ingin%20konsultasi%20kebutuhan%20proyek." target="_blank" rel="noopener noreferrer" data-cta-location="inquiry_sidebar" class="mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-csk-black px-4 py-3 text-sm font-semibold text-white transition hover:bg-csk-black/85">
            Chat WhatsApp
          </a>
        </div>
        <div class="rounded-2xl border border-csk-gray/15 bg-white p-6">
          <h2 class="text-base font-semibold text-csk-black">Informasi workshop</h2>
          <p class="mt-2 text-sm leading-relaxed text-csk-gray">Jl. Doel Silem No. 45, Rawa Mekar Jaya, Serpong, Tangerang Selatan, Banten 15310.</p>
          <p class="mt-3 text-xs leading-relaxed text-csk-gray">Senin–Jumat 08.00–17.00 WIB<br/>Sabtu 08.00–15.00 WIB</p>
          <a href="/kontak/" class="mt-4 inline-block text-sm font-semibold text-csk-amber-text underline">Lihat detail kontak</a>
        </div>
      </aside>
    </div>
  </Section>
</Base>
