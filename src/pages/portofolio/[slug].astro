---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import Lightbox from '../../components/Lightbox.astro';
import WaIcon from '../../components/WaIcon.astro';
import { caseStudies, portfolio, waLink } from '../../site.js';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const images = study.images
  .map((name) => portfolio.find((item) => item.img === name))
  .filter(Boolean);
const breadcrumbs = [
  { href: '/portofolio/', label: 'Portofolio' },
  { href: `/portofolio/${study.slug}/`, label: study.client },
];

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: study.title,
  description: study.description,
  creator: { '@type': 'Organization', name: 'Cahaya Selatan Kreasindo' },
  locationCreated: study.location,
  about: study.category,
  url: new URL(`/portofolio/${study.slug}/`, Astro.site).href,
};
---
<Base
  title={`${study.title} | Portofolio CSK`}
  description={study.description}
  image="/og-image.webp"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <Section
    as="h1"
    eyebrow={`Studi Kasus · ${study.category}`}
    title={study.title}
    lead={study.description}
  >
    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full border border-csk-gray/20 px-4 py-2 text-csk-gray">Brand: <strong class="text-csk-black">{study.client}</strong></span>
      <span class="rounded-full border border-csk-gray/20 px-4 py-2 text-csk-gray">Lokasi: <strong class="text-csk-black">{study.location}</strong></span>
    </div>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={waLink(study.waMessage)} data-cta-location="case_study_top" target="_blank" rel="noopener"
         class="inline-flex min-h-12 items-center gap-2 rounded-full bg-csk-amber px-6 py-3 text-sm font-semibold text-csk-black transition-colors hover:bg-csk-amber/90">
        <WaIcon />Konsultasikan Project Serupa
      </a>
      <a href={study.serviceHref}
         class="inline-flex min-h-12 items-center rounded-full border border-csk-gray/25 px-6 py-3 text-sm font-semibold text-csk-black transition-colors hover:bg-csk-gray/10">
        Lihat Layanan: {study.serviceLabel}
      </a>
    </div>
  </Section>

  <Section class="border-t border-csk-gray/15 pt-10">
    <div class="grid gap-8 md:grid-cols-[1fr_.8fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-amber-text">Ringkasan proyek</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-csk-black">Kebutuhan dan hasil pengerjaan</h2>
        <p class="mt-4 leading-relaxed text-csk-gray">{study.description}</p>
      </div>
      <div class="rounded-2xl border border-csk-gray/20 bg-csk-gray/5 p-6">
        <h2 class="text-sm font-semibold uppercase tracking-[0.12em] text-csk-amber-text">Dokumentasi yang tersedia</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-csk-gray">
          {study.deliverables.map((item) => (
            <li class="flex gap-2"><span class="text-csk-amber">—</span>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section class="border-t border-csk-gray/15 pt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-amber-text">Galeri proyek</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-csk-black">Dokumentasi pengerjaan</h2>
      </div>
      <span class="text-sm text-csk-gray">{images.length} foto dokumentasi</span>
    </div>
    <div class="mt-7 grid gap-5 sm:grid-cols-2" data-lightbox>
      {images.map((item) => (
        <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
          <div class="aspect-[4/3] overflow-hidden bg-csk-gray/10">
            <Picture
              name={item.img}
              alt={item.title}
              sizes="(min-width: 640px) 540px, 94vw"
              class="h-full w-full cursor-zoom-in object-contain"
            />
          </div>
          <figcaption class="p-4 text-sm leading-relaxed text-csk-gray">{item.title}</figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section class="border-t border-csk-gray/15 text-center">
    <h2 class="text-2xl font-semibold tracking-tight text-csk-black">Punya kebutuhan project serupa?</h2>
    <p class="mx-auto mt-3 max-w-2xl leading-relaxed text-csk-gray">
      Sampaikan jenis pekerjaan, ukuran atau jumlah, lokasi, dan target waktu. Tim CSK dapat membantu membahas kebutuhan produksi dan instalasinya.
    </p>
    <a href={waLink(study.waMessage)} data-cta-location="case_study_bottom" target="_blank" rel="noopener"
       class="mt-7 inline-flex min-h-12 items-center gap-2 rounded-full bg-csk-black px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-csk-black/80">
      <WaIcon />Diskusikan Project Anda
    </a>
    <p class="mt-5"><a href="/portofolio/" class="text-sm font-semibold text-csk-amber-text hover:underline">← Kembali ke semua portofolio</a></p>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <Lightbox />
</Base>
