---
const { items } = Astro.props; // [{href, label}] tanpa Beranda
const trail = [{ href: '/', label: 'Beranda' }, ...items];
---
<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-5 pt-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    {trail.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < trail.length - 1
          ? <a href={it.href} class="hover:text-csk-amber">{it.label}</a>
          : <span class="text-slate-700" aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
