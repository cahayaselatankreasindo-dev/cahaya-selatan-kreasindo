---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { portfolio, portfolioCats, waLink } from '../site.js';

const slug = (c) => c.replace(/[^a-zA-Z]+/g, '-').toLowerCase();
const catLink = {
  'Booth & Pameran': '/layanan/booth-pameran/',
  'Rak Display': '/layanan/rak-display-gondola/',
  'POSM': '/layanan/posm-display/',
  'Neon Box & Signage': '/layanan/neon-box-signage/',
  'Proses Produksi': '/tentang/',
};
// Guides support the corresponding service. They do not replace commercial service pages.
const catGuide = {
  'Booth & Pameran': '/blog/checklist-brief-booth-pameran-custom/',
  'Rak Display': '/blog/memilih-rak-display-custom-gondola-toko/',
  'POSM': '/blog/floor-display-vs-counter-display-posm/',
  'Neon Box & Signage': '/blog/panduan-neon-box-vs-huruf-timbul/',
};
import WaIcon from '../components/WaIcon.astro';
import Lightbox from '../components/Lightbox.astro';
---
<Base
  title="Portofolio Display & Booth"
  description="Lihat dokumentasi proyek CSK: booth pameran, rak gondola, POSM, neon box, signage, dan proses produksi untuk klien di Jabodetabek."
  image="/og-image.webp"
  breadcrumbs={[{ href: '/portofolio', label: 'Portofolio' }]}
>
  <Breadcrumbs items={[{ href: '/portofolio', label: 'Portofolio' }]} />

  <Section
    as="h1"
    eyebrow="Portofolio"
    title="Pekerjaan yang sudah kami kerjakan"
    lead="Booth pameran, rak display ritel, neon box, sampai signage toko — dikerjakan sendiri oleh tim kami dari desain hingga pemasangan."
  >
    <div class="mt-8 flex flex-wrap gap-2">
      {portfolioCats.map((c) => (
        <a href={`#${slug(c)}`}
            class="rounded-full border border-csk-gray/30 px-4 py-1.5 text-sm text-csk-amber-text transition-colors hover:bg-csk-gray/10">
          {c}
        </a>
      ))}
    </div>
  </Section>

  {portfolioCats.map((cat, catIndex) => {
    const items = portfolio.filter((p) => p.cat === cat);
    const hasFeature = items.length >= 3;

    return (
      <section id={slug(cat)} class="mx-auto max-w-6xl scroll-mt-24 px-5 pb-20" aria-labelledby={'kategori-' + slug(cat)}>
        <div class="flex flex-wrap items-end justify-between gap-5 border-t border-csk-gray/20 pt-8">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-csk-amber-text">
              Dokumentasi proyek
            </p>
            <h2 id={'kategori-' + slug(cat)} class="text-2xl font-bold leading-tight tracking-tight text-csk-black sm:text-3xl">{cat}</h2>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href={catLink[cat]} class="inline-flex min-h-11 items-center text-sm font-semibold text-csk-amber-text underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
              {cat === 'Proses Produksi' ? 'Lihat proses kerja →' : 'Lihat layanan terkait →'}
            </a>
            {catGuide[cat] && (
              <a href={catGuide[cat]} class="inline-flex min-h-11 items-center text-sm font-medium text-csk-gray underline-offset-4 hover:text-csk-amber-text hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
                Panduan terkait →
              </a>
            )}
          </div>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:auto-rows-[235px] lg:grid-cols-3 lg:grid-flow-row-dense lg:gap-4" data-lightbox>
          {items.map((p, index) => (
            <figure
              id={'proyek-' + p.img}
              data-portfolio-reveal
              class:list={[
                'group relative isolate min-h-[280px] scroll-mt-28 overflow-hidden rounded-xl bg-csk-black sm:min-h-[300px] lg:min-h-0',
                hasFeature && index === 0 ? 'sm:col-span-2 lg:col-span-2 lg:row-span-2' : '',
              ]}
            >
              <Picture
                name={p.img}
                alt={p.title}
                sizes={hasFeature && index === 0
                  ? '(min-width: 1024px) 740px, (min-width: 640px) 90vw, 95vw'
                  : '(min-width: 1024px) 360px, (min-width: 640px) 45vw, 95vw'}
                loading={catIndex === 0 && index === 0 ? 'eager' : 'lazy'}
                fetchpriority={catIndex === 0 && index === 0 ? 'high' : undefined}
                class="absolute inset-0 h-full w-full cursor-zoom-in object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.035]"
              />
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-csk-black/90 via-csk-black/25 to-transparent"></div>
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 p-5 text-white sm:p-6 lg:p-7">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/80">
                  {cat}
                </p>
                <h3 class:list={[
                  'max-w-2xl font-semibold leading-snug text-white',
                  hasFeature && index === 0 ? 'text-xl sm:text-2xl lg:text-3xl' : 'text-base sm:text-lg',
                ]}>
                  {p.title}
                </h3>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    );
  })}

  <Section class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Mau hasil serupa untuk brand Anda?</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">
      Kirim referensi atau foto lokasi, kami bantu susun konsep dan estimasi biayanya.
    </p>
    <a href={waLink('Halo, saya lihat portofolio di website. Saya ingin konsultasi untuk kebutuhan berikut:')}
       target="_blank" rel="noopener"
       class="mt-8 inline-flex items-center gap-2 rounded-full bg-csk-amber px-7 py-3 text-sm font-medium text-csk-black transition-colors hover:bg-csk-amber/90">
      <WaIcon />Konsultasi Sekarang
    </a>
  </Section>
  <Lightbox />
  <style>
    [data-portfolio-reveal] {
      transition:
        opacity 550ms ease,
        transform 550ms cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 240ms ease;
    }

    /* Hover treatments only apply where the device has a precise pointer. */
    @media (hover: hover) and (pointer: fine) {
      [data-portfolio-reveal]:hover {
        box-shadow: 0 18px 36px -24px rgba(11, 11, 11, 0.3);
      }
    }

    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      [data-portfolio-reveal]:not([data-reveal-pending]):hover {
        transform: translate3d(0, -4px, 0);
      }
    }

    [data-portfolio-reveal][data-reveal-pending] {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-portfolio-reveal] {
        transition: none;
        transform: none;
      }
    }
  </style>

  <script>
    const revealCards = Array.from(document.querySelectorAll<HTMLElement>('[data-portfolio-reveal]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Keep above-the-fold cards visible so this animation never delays first paint.
    if ('IntersectionObserver' in window && !reducedMotion.matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.removeAttribute('data-reveal-pending');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.05, rootMargin: '0px 0px -24px 0px' });

      for (const card of revealCards) {
        if (card.getBoundingClientRect().top > window.innerHeight) {
          card.setAttribute('data-reveal-pending', '');
          observer.observe(card);
        }
      }

      // If a visitor enables reduced motion mid-session, reveal everything.
      reducedMotion.addEventListener('change', () => {
        if (!reducedMotion.matches) return;
        observer.disconnect();
        for (const card of revealCards) card.removeAttribute('data-reveal-pending');
      });
    }
  </script>
</Base>
