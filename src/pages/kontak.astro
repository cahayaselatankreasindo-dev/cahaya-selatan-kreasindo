---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, areas, waLink } from '../site.js';
const mapQ = encodeURIComponent(site.address);
---
<Base
  title="Kontak & Alamat Workshop"
  description="Hubungi CSK via WhatsApp atau email untuk penawaran booth, display, POSM, dan signage. Workshop kami berada di Serpong, Tangerang Selatan."
  breadcrumbs={[{ href: '/kontak', label: 'Kontak' }]}
>
  <Breadcrumbs items={[{ href: '/kontak', label: 'Kontak' }]} />

  <Section as="h1" eyebrow="Kontak" title="Hubungi kami"
           lead="Balasan tercepat lewat WhatsApp pada jam kerja. Kirim foto lokasi, ukuran, atau referensi desain supaya estimasi bisa langsung kami hitung.">
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <a href={waLink()} target="_blank" rel="noopener"
         class="rounded-2xl border border-csk-gray/20 p-7 transition-colors hover:bg-csk-gray/10">
        <h2 class="text-sm font-medium text-csk-amber-text">WhatsApp</h2>
        <p class="mt-2 text-lg font-semibold">{site.waDisplay}</p>
        <p class="mt-2 text-sm text-slate-600">Chat langsung untuk konsultasi &amp; penawaran.</p>
      </a>
      <a href={`mailto:${site.email}`}
         class="rounded-2xl border border-csk-gray/20 p-7 transition-colors hover:bg-csk-gray/10">
        <h2 class="text-sm font-medium text-csk-amber-text">Email</h2>
        <p class="mt-2 break-all text-lg font-semibold">{site.email}</p>
        <p class="mt-2 text-sm text-slate-600">Untuk kebutuhan dokumen &amp; penawaran resmi.</p>
      </a>
      <div class="rounded-2xl border border-csk-gray/20 p-7">
        <h2 class="text-sm font-medium text-csk-amber-text">Jam operasional</h2>
        <dl class="mt-2 space-y-1 text-sm">
          {site.hours.map((h) => (
            <div class="flex justify-between gap-3">
              <dt class="text-slate-600">{h.days}</dt>
              <dd class="font-medium">{h.time}</dd>
            </div>
          ))}
          <div class="flex justify-between gap-3">
            <dt class="text-slate-600">Minggu &amp; libur nasional</dt>
            <dd class="font-medium">Tutup</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-[1fr_1.2fr]">
      <div class="rounded-2xl border border-csk-gray/20 p-7">
        <h2 class="text-sm font-medium text-csk-amber-text">Workshop & Kontak</h2>
        <address class="mt-2 not-italic leading-relaxed text-slate-700">
          <strong class="font-semibold text-csk-black">Cahaya Selatan Kreasindo</strong><br />
          Jl. Doel Silem No. 45, Rawa Mekar Jaya, Serpong<br />
          Tangerang Selatan, Banten 15310<br />
          Indonesia
        </address>
        <p class="mt-4 text-sm text-slate-600">
          Kunjungan workshop sebaiknya dijadwalkan dulu lewat WhatsApp agar tim yang menangani proyek Anda ada di tempat.
        </p>
        <div class="mt-6 space-y-2">
          <p class="text-sm">
            <strong class="text-csk-black">WhatsApp:</strong> 0888-8533-488
          </p>
          <p class="text-sm">
            <strong class="text-csk-black">Email:</strong> <a href={`mailto:${site.email}`} class="text-csk-amber-text hover:underline">{site.email}</a>
          </p>
        </div>
        <h3 class="mt-6 text-sm font-medium text-csk-amber-text">Area yang kami layani</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {areas.map((a) => (
            <li class="rounded-full border border-csk-gray/30 px-3 py-1 text-xs text-csk-amber-text">{a.name}</li>
          ))}
        </ul>
        <a href="/area-layanan" class="mt-4 inline-block text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
          Detail area layanan →
        </a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-csk-gray/20">
        <iframe
          title="Lokasi workshop Cahaya Selatan Kreasindo di Serpong"
          class="h-full min-h-80 w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://maps.google.com/maps?q=${mapQ}&output=embed`}
        ></iframe>
      </div>
    </div>
  </Section>

  <section class="border-t border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Informasi yang membantu kami menyiapkan penawaran</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
        Anda tidak harus sudah memiliki gambar kerja final untuk memulai konsultasi. Gambaran kebutuhan yang jelas
        membantu tim memahami fungsi produk, ruang pemasangan, dan target pekerjaan. Jika ukuran belum pasti,
        kirim perkiraan ukuran serta foto lokasi agar kebutuhan teknis awal dapat dibahas.
      </p>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <article class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="font-semibold">Data proyek yang sebaiknya disiapkan</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
            <li>Jenis kebutuhan: booth, rak display, POSM, neon box, signage, atau perlengkapan event.</li>
            <li>Ukuran produk atau area pemasangan, termasuk foto dari beberapa sudut bila tersedia.</li>
            <li>Jumlah unit, jumlah outlet, dan apakah produk perlu dibuat dalam satu batch.</li>
            <li>Alamat pengiriman atau pemasangan serta informasi akses lokasi.</li>
            <li>Referensi desain, logo, panduan warna brand, dan target tanggal selesai.</li>
          </ul>
        </article>
        <article class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="font-semibold">Apa yang dibahas saat konsultasi?</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Tim akan meninjau fungsi produk, spesifikasi, material, finishing, jumlah, serta kebutuhan pengiriman atau
            instalasi. Dari informasi tersebut, ruang lingkup pekerjaan dan data tambahan yang diperlukan dapat
            ditentukan sebelum penawaran disusun.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Untuk pekerjaan yang bergantung pada kondisi lapangan, foto dan ukuran awal membantu pembahasan.
            Survei atau kunjungan workshop dijadwalkan lebih dahulu melalui WhatsApp.
          </p>
        </article>
      </div>
      <h2 class="mt-10 text-xl font-semibold tracking-tight md:text-2xl">Pertanyaan sebelum menghubungi CSK</h2>
      <div class="mt-5 space-y-3">
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Bisakah konsultasi jika belum memiliki desain?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Bisa. Sampaikan tujuan penggunaan, jenis produk, ukuran perkiraan, foto lokasi, dan referensi visual yang disukai.
            Tim dapat membahas kebutuhan awal dan menentukan apakah diperlukan gambar kerja atau penyesuaian desain
            sebelum produksi. Persetujuan spesifikasi dilakukan sebelum pekerjaan dimulai.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Apakah CSK menerima pesanan satu unit maupun jumlah banyak?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Kebutuhan satu unit maupun produksi beberapa unit dapat dikonsultasikan. Ketentuan jumlah bergantung pada
            jenis pekerjaan, material, proses produksi, dan kebutuhan pemasangan. Untuk POSM dan rak display, kebutuhan
            satu unit maupun batch beberapa outlet dapat dibahas sesuai spesifikasi.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Apakah workshop dapat dikunjungi?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Bisa dengan membuat janji terlebih dahulu. Hubungi WhatsApp dan sampaikan rencana kunjungan agar tim yang
            menangani kebutuhan Anda dapat mengatur waktu. Workshop berada di Jl. Doel Silem No. 45, Rawa Mekar Jaya,
            Serpong, Tangerang Selatan.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Apakah CSK melayani proyek di luar Jabodetabek?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Beberapa kebutuhan, termasuk booth pameran dan rak display, dapat diproduksi di workshop lalu dikirim ke
            kota tujuan. Kebutuhan instalasi, mobilisasi, dan biaya pengiriman dibahas berdasarkan jenis produk,
            alamat, akses lokasi, serta jadwal proyek.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Bagaimana cara menghitung estimasi biaya?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Estimasi mempertimbangkan ukuran, material, finishing, jumlah unit, tingkat kerumitan, lokasi, dan kebutuhan
            pengiriman atau instalasi. Kirim informasi awal melalui WhatsApp atau email. Jika ada detail yang belum
            tersedia, tim akan menyampaikan data yang perlu dilengkapi agar perhitungan lebih akurat.
          </p>

        
        </details>
<details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Bisakah CSK membantu desain dari referensi atau brief awal?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Bisa. Kirim logo, panduan identitas brand bila ada, contoh visual, dan gambaran fungsi produk.
            Tim akan membahas kebutuhan gambar kerja serta penyesuaian ukuran dan material. Desain atau gambar
            kerja yang akan diproduksi perlu disetujui terlebih dahulu agar spesifikasi menjadi acuan yang sama.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Apakah penawaran selalu termasuk pengiriman dan instalasi?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Tidak selalu. Penawaran mengikuti ruang lingkup yang diminta: produksi barang saja, pengiriman,
            perakitan, instalasi, atau pembongkaran setelah acara. Sampaikan sejak awal layanan yang dibutuhkan
            agar komponen pekerjaan dan biayanya dijelaskan secara terpisah bila diperlukan.
          </p>
        </details>
        <details class="rounded-xl border border-csk-gray/20 bg-white p-5">
          <summary class="cursor-pointer font-semibold">Apa informasi tambahan untuk pemesanan booth pameran?</summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Sertakan nama venue, ukuran area atau denah booth, tanggal acara, jadwal loading, aturan teknis gedung,
            dan kebutuhan seperti meja, kabinet, listrik, pencahayaan, atau layar. Jika detail venue belum lengkap,
            kirim informasi yang tersedia terlebih dahulu untuk menentukan hal yang perlu dikonfirmasi.
          </p>
        </details>

      </div>
    </div>
  </section>

</Base>
