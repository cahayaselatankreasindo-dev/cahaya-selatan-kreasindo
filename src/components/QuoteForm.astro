---
import { site } from '../site.js';
const { productName, serviceName } = Astro.props;
---
<section id="penawaran" class="border-y border-csk-gray/20 bg-csk-gray/10">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr] md:py-20">
    <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-csk-amber-text">Permintaan Penawaran</p><h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-csk-black">Ceritakan kebutuhan produk Anda.</h2><p class="mt-4 text-sm leading-relaxed text-csk-gray">Isi spesifikasi awal agar tim CSK dapat memahami kebutuhan dan menyiapkan diskusi penawaran melalui WhatsApp.</p><ul class="mt-6 space-y-3 text-sm text-csk-gray"><li>— Ukuran dan jumlah unit membantu estimasi lebih akurat.</li><li>— Material serta finishing ditetapkan setelah desain ditinjau.</li><li>— Foto atau PDF referensi dapat dibagikan bersama pesan jika browser mendukung.</li></ul></div>
    <form data-quote-form data-wa={site.wa} data-product={productName} data-service={serviceName} class="rounded-xl border border-csk-gray/20 bg-white p-5 sm:p-7">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-csk-black">Nama kontak *<input name="name" required autocomplete="name" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="Nama Anda" /></label>
        <label class="block text-sm font-medium text-csk-black">Perusahaan / brand<input name="company" autocomplete="organization" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="Nama perusahaan atau brand" /></label>
        <label class="block text-sm font-medium text-csk-black">Ukuran perkiraan<input name="size" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="P × L × T (cm)" /></label>
        <label class="block text-sm font-medium text-csk-black">Jumlah unit<input name="quantity" inputmode="numeric" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="Contoh: 10 unit" /></label>
        <label class="block text-sm font-medium text-csk-black">Material pilihan<select name="material" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 bg-white px-3 text-sm outline-none focus:border-csk-amber"><option value="">Belum ditentukan / minta saran</option><option>Akrilik</option><option>PVC board / foamboard</option><option>Karton / corrugated</option><option>MDF / HMR / plywood</option><option>Besi / metal</option><option>Kombinasi material</option></select></label>
        <label class="block text-sm font-medium text-csk-black">Finishing<select name="finish" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 bg-white px-3 text-sm outline-none focus:border-csk-amber"><option value="">Belum ditentukan / minta saran</option><option>Cat / duco</option><option>HPL</option><option>Stiker / digital print</option><option>Poles akrilik</option><option>LED / backlit</option><option>Kombinasi finishing</option></select></label>
        <label class="block text-sm font-medium text-csk-black">Lokasi pengiriman / pemasangan<input name="location" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="Kota / area outlet" /></label>
        <label class="block text-sm font-medium text-csk-black">Target waktu<input name="deadline" class="mt-2 min-h-11 w-full rounded-md border border-csk-gray/30 px-3 text-sm outline-none focus:border-csk-amber" placeholder="Tanggal atau estimasi" /></label>
      </div>
      <label class="mt-5 block text-sm font-medium text-csk-black">Catatan kebutuhan<textarea name="notes" rows="4" class="mt-2 w-full rounded-md border border-csk-gray/30 px-3 py-3 text-sm outline-none focus:border-csk-amber" placeholder="Fungsi display, ukuran produk, kondisi lokasi, atau detail lain."></textarea></label>
      <label class="mt-5 block text-sm font-medium text-csk-black">Referensi foto / PDF (opsional)<input name="reference" type="file" accept="image/*,.pdf" class="mt-2 block w-full rounded-md border border-csk-gray/30 p-3 text-sm file:mr-3 file:rounded file:border-0 file:bg-csk-gray/10 file:px-3 file:py-2 file:text-sm file:font-semibold" /></label>
      <p class="mt-2 text-xs leading-relaxed text-csk-gray">Maksimal 10 MB. Jika perangkat mendukung berbagi file, referensi dapat dikirim bersama pesan. Jika tidak, WhatsApp dibuka dan file perlu dilampirkan manual. File tidak disimpan di server website.</p>
      <button type="submit" class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black hover:brightness-95">Siapkan Permintaan via WhatsApp</button>
      <p data-quote-status role="status" aria-live="polite" class="mt-3 min-h-5 text-xs leading-relaxed text-csk-gray"></p>
    </form>
  </div>
</section>
<script>
  document.querySelectorAll('[data-quote-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      const read = (key) => String(data.get(key) || 'Belum diisi').trim();
      const input = form.querySelector('input[name="reference"]');
      const file = input instanceof HTMLInputElement ? input.files?.[0] : undefined;
      const status = form.querySelector('[data-quote-status]');
      const setStatus = (message) => { if (status) status.textContent = message; };
      if (file && file.size > 10 * 1024 * 1024) { setStatus('Ukuran file melebihi 10 MB. Pilih file yang lebih kecil.'); return; }
      const message = [
        'Halo CSK, saya ingin meminta penawaran.', '',
        'Produk: ' + form.dataset.product, 'Layanan: ' + form.dataset.service,
        'Nama kontak: ' + read('name'), 'Perusahaan / brand: ' + read('company'),
        'Ukuran: ' + read('size'), 'Jumlah unit: ' + read('quantity'),
        'Material: ' + read('material'), 'Finishing: ' + read('finish'),
        'Lokasi: ' + read('location'), 'Target waktu: ' + read('deadline'),
        'Catatan: ' + read('notes'), 'Referensi: ' + (file ? file.name : 'Tidak dilampirkan')
      ].join('\n');
      if (file && typeof navigator.share === 'function' && typeof navigator.canShare === 'function' && navigator.canShare({ files: [file] })) {
        try {
          await navigator.share({ title: 'Permintaan Penawaran CSK', text: message, files: [file] });
          setStatus('Menu berbagi terbuka. Pilih WhatsApp untuk mengirim pesan dan file referensi.');
          return;
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
        }
      }
      setStatus(file ? 'WhatsApp dibuka dengan spesifikasi. Lampirkan file referensi secara manual di chat.' : 'WhatsApp dibuka dengan rincian permintaan penawaran.');
      window.location.assign('https://wa.me/' + form.dataset.wa + '?text=' + encodeURIComponent(message));
    });
  });
</script>