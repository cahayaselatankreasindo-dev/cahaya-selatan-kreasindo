---
import { site, waLink } from '../site.js';

const icon = 'h-4 w-4 shrink-0 text-brand-500';
---
<footer class="mt-24 border-t border-brand-100 bg-brand-50/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="text-base font-semibold">{site.name}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-600">{site.tagline}</p>
      <a href={waLink()} target="_blank" rel="noopener"
         class="mt-5 inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-600">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.43-9.41 2.52 0 4.88.98 6.66 2.76a9.34 9.34 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.42 9.42zM20.5 3.49A11.75 11.75 0 0 0 12.04 0C5.55 0 .27 5.28.26 11.76c0 2.07.54 4.1 1.57 5.88L.16 24l6.5-1.7a11.74 11.74 0 0 0 5.38 1.37h.01c6.49 0 11.77-5.28 11.77-11.76 0-3.14-1.22-6.1-3.44-8.32z" />
        </svg>
        Chat WhatsApp
      </a>
    </div>
    <div class="text-sm">
      <p class="font-medium text-slate-900">Kontak</p>
      <ul class="mt-3 space-y-2 text-slate-600">
        <li>
          <a class="inline-flex items-center gap-2 hover:text-brand-700" href={waLink()} target="_blank" rel="noopener">
            <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.41 9.43-9.41 2.52 0 4.88.98 6.66 2.76a9.34 9.34 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.42 9.42zM20.5 3.49A11.75 11.75 0 0 0 12.04 0C5.55 0 .27 5.28.26 11.76c0 2.07.54 4.1 1.57 5.88L.16 24l6.5-1.7a11.74 11.74 0 0 0 5.38 1.37h.01c6.49 0 11.77-5.28 11.77-11.76 0-3.14-1.22-6.1-3.44-8.32z" />
            </svg>
            WhatsApp {site.waDisplay}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-2 hover:text-brand-700" href={`mailto:${site.email}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            {site.email}
          </a>
        </li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="font-medium text-slate-900">Workshop</p>
      <div class="mt-3 flex items-start gap-2 text-slate-600">
        <svg class={`${icon} mt-0.5`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <address class="not-italic leading-relaxed">
          {site.street}<br />{site.city}, {site.region} {site.postalCode}
        </address>
      </div>
      <p class="mt-3 flex items-start gap-2 text-slate-600">
        <svg class={`${icon} mt-0.5`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        <span>Senin–Jumat 08.00–17.00 · Sabtu 08.00–15.00 WIB</span>
      </p>
      <a href="/area-layanan" class="mt-2 inline-block text-brand-700 hover:text-brand-800">Area layanan →</a>
    </div>
  </div>
  <div class="border-t border-brand-100 py-5 text-center text-xs text-slate-500">
    © {new Date().getFullYear()} {site.name} — Event Booth &amp; Exhibition Specialist.
  </div>
</footer>
