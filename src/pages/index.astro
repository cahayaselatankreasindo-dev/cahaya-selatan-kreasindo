---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import WaIcon from '../components/WaIcon.astro';
import Lightbox from '../components/Lightbox.astro';
import AssetImage from '../components/AssetImage.astro';
import Picture from '../components/Picture.astro';
import responsiveImages from '../generated/homepage-responsive.json';

import { serviceDetails, waLink, areas, portfolio } from '../site.js';

const featuredPortfolio = portfolio.filter((p) => p.featured);
const portfolioHighlights = [
  { category: 'Rak Display', href: '/layanan/rak-display-gondola/' },
  { category: 'Neon Box & Signage', href: '/layanan/neon-box-signage/' },
  { category: 'Booth & Pameran', href: '/layanan/booth-pameran/' },
  { category: 'Proses Produksi', href: '/tentang/' },
];
const responsiveSrcset = (src) => responsiveImages[src]?.srcset;
---
<Base
      title="Jasa Booth Pameran & Rak Display"
      description="Cahaya Selatan Kreasindo, jasa pembuatan booth pameran, rak display custom, neon box, dan signage di Tangerang Selatan. Dikerjakan sendiri dari desain sampai pemasangan."
>
      <section>
        <div class="mx-auto max-w-6xl px-5 py-12 md:py-16">
          <h1 class="text-3xl font-bold leading-tight text-csk-black sm:text-4xl md:text-5xl">
            Wujudkan Branding Visual terbaik bersama kami.
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-csk-gray sm:text-lg">
            Production partner terpercaya untuk semua kebutuhan display, booth pameran, dan branding bisnis Anda.
          </p>
        </div>
        <div class="border-t border-csk-gray/10">
          <div class="grid grid-cols-1 divide-y md:grid-cols-3 md:divide-x md:divide-y-0 md:divide-csk-gray/10">
            <a href="/layanan/visual-merchandising"
               class="group relative block min-h-[280px] md:h-[480px] lg:h-[560px] overflow-hidden">
               <AssetImage
                 src="/assets/rak-display-bioxine/1ebe3b6d-1102-440d-80e9-8af4d444d7f2.webp"
                 srcset={responsiveSrcset('/assets/rak-display-bioxine/1ebe3b6d-1102-440d-80e9-8af4d444d7f2.webp')}
                 sizes="(min-width: 768px) 33vw, 100vw"
                 alt="Retail dan visual merchandising — rak display akrilik untuk produk kecantikan di toko ritel"
                 loading="eager"
                 fetchpriority="high"
                 width="2160"
                 height="3840"
                 class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
               />
              <div class="absolute inset-0 bg-black/50"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
                <span class="text-xs font-semibold tracking-[0.2em] uppercase text-white">01</span>
                <h2 class="mt-2 text-xl font-bold uppercase leading-none text-white sm:text-2xl md:text-3xl lg:text-4xl">
                  Retail &amp;<br/>Merchandising
                </h2>
              </div>
            </a>
            <a href="/layanan/neon-box-signage"
               class="group relative block min-h-[280px] md:h-[480px] lg:h-[560px] overflow-hidden">
                <AssetImage
                  src="/assets/neon-box/neon-box-sakala.webp"
                  srcset={responsiveSrcset('/assets/neon-box/neon-box-sakala.webp')}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt="Signage dan branding — neon box SAKALA bercahaya untuk identity brand"
                  loading="lazy"
                  width="810"
                  height="1080"
                  class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
                />
              <div class="absolute inset-0 bg-black/50"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
                <span class="text-xs font-semibold tracking-[0.2em] uppercase text-white">02</span>
                <h2 class="mt-2 text-xl font-bold uppercase leading-none text-white sm:text-2xl md:text-3xl lg:text-4xl">
                  Signage &amp;<br/>Branding
                </h2>
              </div>
            </a>
            <a href="/layanan/booth-pameran"
               class="group relative block min-h-[280px] md:h-[480px] lg:h-[560px] overflow-hidden">
                <AssetImage
                  src="/assets/booth-exhibition/0452bbb6-c756-4e37-9c10-91a6274065b0.webp"
                  srcset={responsiveSrcset('/assets/booth-exhibition/0452bbb6-c756-4e37-9c10-91a6274065b0.webp')}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  alt="Booth pameran dan custom build — aktivasi brand Perfetto di atrium mall"
                  loading="lazy"
                  width="1200"
                  height="1600"
                  class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
                />
              <div class="absolute inset-0 bg-black/50"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
                <span class="text-xs font-semibold tracking-[0.2em] uppercase text-white">03</span>
                <h2 class="mt-2 text-xl font-bold uppercase leading-none text-white sm:text-2xl md:text-3xl lg:text-4xl">
                  Booth &amp;<br/>Custom Build
                </h2>
              </div>
            </a>
          </div>
        </div>
      </section>

      <Section eyebrow="Layanan" title="Apa yang Kami Kerjakan"
                 lead="Detail kebutuhan produksi dan implementasi untuk brand, retail, dan project commercial.">
        <div class="mt-12 grid gap-x-px bg-csk-gray/15 md:grid-cols-2">
          {serviceDetails.map((s) => (
            <a href={`/layanan/${s.slug}`}
               data-home-reveal
               class="group block bg-white border-b border-csk-gray/15"
               aria-label={`Lihat detail layanan ${s.title}`}>
              <div class="aspect-4/3 overflow-hidden">
                <AssetImage
                  src={s.assetImage}
                  srcset={responsiveSrcset(s.assetImage)}
                  sizes="(min-width: 1152px) 576px, (min-width: 768px) 50vw, calc(100vw - 40px)"
                  alt={s.title}
                  loading="lazy"
                  {...s.assetImage.includes('A46AB99C') && { width: 1600, height: 1200 }}
                  class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-105"
                />
                </div>
                <div class="px-6 py-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-csk-amber-text">{s.cat}</p>
                  <h3 class="mt-2 text-base font-bold uppercase leading-tight text-csk-black group-hover:text-csk-amber">
                    {s.nav}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-csk-gray line-clamp-2">{s.lead}</p>
                  <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-csk-black group-hover:text-csk-amber">
                    Selengkapnya <span aria-hidden="true">&rarr;</span>
                  </span>
                </div>
              </a>
          ))}
        </div>
      </Section>


      <Section eyebrow="Portofolio" title="Project yang Kami Tangani"
                 lead="Pilihan pekerjaan nyata CSK, dari retail display dan signage hingga booth dan proses produksi.">
        <div class="mt-10 space-y-14 md:space-y-20">
          {portfolioHighlights.map(({ category, href }) => {
            const projects = featuredPortfolio.filter((p) => p.cat === category);
            const hasFeature = projects.length >= 3;
            if (projects.length === 0) return null;

            return (
              <section aria-label={'Portofolio ' + category}>
                <div class="mb-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-t border-csk-gray/20 pt-5">
                  <h3 class="text-xl font-bold leading-tight tracking-tight text-csk-black sm:text-2xl">
                    {category}
                  </h3>
                  <a
                    href={href}
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-csk-amber-text underline-offset-4 transition-colors hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber"
                  >
                    {category === 'Proses Produksi' ? 'Lihat proses kerja →' : 'Lihat layanan terkait →'}
                  </a>
                </div>
                <div class="grid gap-3 sm:grid-cols-2 lg:auto-rows-[245px] lg:grid-flow-row-dense lg:grid-cols-3 lg:gap-4" data-lightbox>
                  {projects.map((p, index) => (
                    <figure
                      data-home-reveal
                      class:list={[
                        'group relative isolate min-h-[290px] overflow-hidden rounded-xl bg-csk-black sm:min-h-[320px] lg:min-h-0',
                        hasFeature && index === 0 ? 'sm:col-span-2 lg:col-span-2 lg:row-span-2' : '',
                        projects.length === 2 && index === 0 ? 'lg:col-span-2' : '',
                        projects.length === 1 ? 'sm:col-span-2 lg:col-span-3 lg:row-span-2' : '',
                      ]}
                    >
                      <Picture
                        name={p.img}
                        alt={p.title}
                        loading="lazy"
                        sizes={projects.length === 1
                          ? '(min-width: 1024px) 1152px, (min-width: 640px) 90vw, 95vw'
                          : index === 0
                            ? '(min-width: 1024px) 750px, (min-width: 640px) 90vw, 95vw'
                            : '(min-width: 1024px) 370px, (min-width: 640px) 45vw, 95vw'}
                        class="absolute inset-0 h-full w-full cursor-zoom-in object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.035]"
                      />
                      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-csk-black/90 via-csk-black/20 to-transparent"></div>
                      <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 p-5 sm:p-6">
                        <h4 class:list={[
                          'max-w-2xl font-semibold leading-snug text-white',
                          index === 0 ? 'text-lg sm:text-xl lg:text-2xl' : 'text-base sm:text-lg',
                        ]}>
                          {p.title}
                        </h4>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            );
          })}
        </div>
        <a href="/portofolio/" class="mt-10 inline-flex min-h-11 items-center rounded-full border border-csk-black px-6 text-sm font-semibold text-csk-black transition-colors hover:bg-csk-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
          Lihat semua portofolio <span aria-hidden="true" class="ml-2">→</span>
        </a>
      </Section>

      <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-csk-gray">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold uppercase leading-none text-csk-black md:text-4xl">Pertanyaan Umum</h2>
        <div class="mt-10 space-y-px bg-csk-gray/15">
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
              <span>Di mana lokasi workshop Cahaya Selatan Kreasindo?</span>
              <span class="ml-6 text-xl text-csk-gray transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-2">
              <p class="text-sm leading-relaxed text-csk-gray">
                Workshop utama kami berlokasi di Jl. Doel Silem No. 45, Rawa Mekar Jaya, Serpong, Tangerang Selatan, Banten 15310. 
                Klien dipersilakan berkunjung untuk meninjau proses produksi dan quality check sebelum pengiriman, 
                sebaiknya dijadwalkan terlebih dahulu via WhatsApp.
              </p>
            </div>
          </details>
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
              <span>Apakah CSK melayani pembuatan booth pameran di luar Tangerang Selatan?</span>
              <span class="ml-6 text-xl text-csk-gray transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-2">
              <p class="text-sm leading-relaxed text-csk-gray">
                Ya. Selain area Serpong dan Tangerang Selatan, kami melayani jasa pembuatan booth pameran, 
                signage, dan rak display custom untuk seluruh area Jabodetabek — Jakarta, Bogor, Depok, Tangerang, dan Bekasi. 
                Produksi tetap di workshop kami, pengiriman dan pemasangan bisa ke seluruh Jabodetabek.
              </p>
            </div>
          </details>
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
              <span>Bagaimana cara menghubungi Cahaya Selatan Kreasindo?</span>
              <span class="ml-6 text-xl text-csk-gray transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-2">
              <p class="text-sm leading-relaxed text-csk-gray">
                Anda bisa menghubungi kami via WhatsApp di nomor 0888-8533-488, 
                atau email ke halo@cahayaselatankreasindo.my.id. 
                Balasan tercepat pada jam kerja Senin–Jumat 08.00–17.00 WIB dan Sabtu 08.00–15.00 WIB.
              </p>
            </div>
          </details>
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
              <span>Apakah project bisa dibuat custom?</span>
              <span class="ml-6 text-xl text-csk-gray transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-2">
              <p class="text-sm leading-relaxed text-csk-gray">
                Ya. Sebagian besar project kami dibuat sesuai kebutuhan,<br/>
                mulai dari ukuran, material, desain, hingga kebutuhan pemasangan.
              </p>
            </div>
          </details>
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
              <span>Apakah CSK membantu dari tahap desain?</span>
              <span class="ml-6 text-xl text-csk-gray transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-2">
              <p class="text-sm leading-relaxed text-csk-gray">
                Bisa. Anda dapat memulai dari ide atau referensi awal,<br/>
                atau langsung masuk ke tahap produksi jika desain dan<br/>
                spesifikasi project sudah tersedia.
              </p>
            </div>
          </details>
          <details class="group bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-base font-bold uppercase leading-tight text-csk-black transition-colors hover:text-csk-amber">
