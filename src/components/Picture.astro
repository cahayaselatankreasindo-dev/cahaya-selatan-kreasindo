---
import { Image } from 'astro:assets';

const images = import.meta.glob('/src/img/*.webp', { eager: true });
const { name, alt, sizes, class: klass = '', loading = 'lazy' } = Astro.props;
const mod = images[`/src/img/${name}.webp`];
if (!mod) throw new Error(`Gambar tidak ditemukan: src/img/${name}.webp`);
---
<Image
  src={mod.default}
  alt={alt}
  widths={[400, 800, 1200]}
  sizes={sizes}
  loading={loading}
  decoding="async"
  class={klass}
/>
