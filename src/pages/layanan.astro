---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { serviceDetails, products, waLink, portfolio } from '../site.js';
import WaIcon from '../components/WaIcon.astro';
---
<Base
  title="Layanan Produksi Display"
  description="Lihat layanan CSK: POSM, rak display, booth pameran, neon box, signage, visual merchandising, dan peralatan event custom di Jabodetabek."
  breadcrumbs={[{ href: '/layanan', label: 'Layanan' }]}
>
  <Breadcrumbs items={[{ href: '/layanan', label: 'Layanan' }]} />
  <Section as="h1" eyebrow="Layanan" title="Solusi display yang tepat untuk bisnis Anda"
           lead="Enam lini pekerjaan, semuanya custom mengikuti ukuran lokasi, karakter produk, dan identitas brand Anda. Pilih yang paling dekat dengan kebutuhan Anda.">
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {serviceDetails.map((s) => (
        <a href={`/layanan/${s.slug}`}
           class="group rounded-2xl border border-csk-gray/20 p-5 transition-shadow hover:shadow-md sm:p-6">
          {s.images?.[0] && (() => {
            const image = portfolio.find((p) => p.img === s.images[0]);
            return image ? (
              <div class="aspect-4/3 overflow-hidden rounded-xl bg-csk-gray/10">
                <Picture
                  name={image.img}
                  alt={image.title}
                  sizes="(min-width: 768px) 360px, 90vw"
                  class="h-full w-full object-contain"
                />
              </div>
            ) : null;
          })()}
          <h2 class="mt-5 text-lg font-semibold">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.lead}</p>
          <span class="mt-4 inline-block text-sm font-medium text-csk-amber-text group-hover:text-csk-amber-text/80">
            Selengkapnya &rarr;
          </span>
        </a>
      ))}
    </div>
  </Section>

  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Produk &amp; peralatan</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">{p.group}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {p.items.map((it) => (
                <li class="flex gap-2"><span class="text-csk-amber">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Memilih layanan sesuai kebutuhan proyek</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
        Mulailah dari fungsi benda dan lokasi penggunaannya. Materi promosi di rak atau kasir masuk ke kategori POSM;
        kebutuhan gondola dan rak toko masuk ke rak display; sedangkan kebutuhan ruang promosi di pameran atau mall
        lebih tepat dibahas sebagai booth dan stand event. Untuk identitas bangunan, toko, atau ruang, pilih neon box,
        huruf timbul, signage, atau visual merchandising sesuai bidang pekerjaannya.
      </p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="font-semibold">Retail dan titik penjualan</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            POSM, floor display, counter display, gondola, dan rak custom membantu menampilkan produk di area belanja.
            Sampaikan jenis produk, ukuran ruang, jumlah unit, serta jumlah outlet agar spesifikasi bisa dibahas dengan tepat.
          </p>
        </article>
        <article class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="font-semibold">Event dan aktivasi brand</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Booth pameran, mini counter, backdrop, dan perlengkapan event perlu disesuaikan dengan ukuran venue,
            aturan loading, jadwal acara, serta rencana pemakaian ulang. Informasi tanggal acara sebaiknya disampaikan sejak awal.
          </p>
        </article>
        <article class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="font-semibold">Signage dan tampilan outlet</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Neon box, huruf timbul, papan nama, window display, dan in-store branding ditentukan oleh kondisi lokasi,
            bidang pemasangan, kebutuhan pencahayaan, serta identitas visual brand.
          </p>
        </article>
      </div>
      <h2 class="mt-10 text-xl font-semibold tracking-tight md:text-2xl">Alur kerja dari brief sampai pemasangan</h2>
      <ol class="mt-5 grid gap-4 md:grid-cols-4">
        <li class="rounded-xl bg-white p-5">
          <span class="text-sm font-semibold text-csk-amber">01</span>
          <h3 class="mt-2 font-semibold">Konsultasi</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Kirim kebutuhan, foto lokasi, ukuran awal, jumlah, dan referensi visual.</p>
        </li>
        <li class="rounded-xl bg-white p-5">
          <span class="text-sm font-semibold text-csk-amber">02</span>
          <h3 class="mt-2 font-semibold">Spesifikasi</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Ruang lingkup, material, finishing, lokasi, dan jadwal disepakati sebelum penawaran.</p>
        </li>
        <li class="rounded-xl bg-white p-5">
          <span class="text-sm font-semibold text-csk-amber">03</span>
          <h3 class="mt-2 font-semibold">Produksi</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Pengerjaan dilakukan berdasarkan gambar kerja dan spesifikasi yang telah disetujui.</p>
        </li>
        <li class="rounded-xl bg-white p-5">
          <span class="text-sm font-semibold text-csk-amber">04</span>
          <h3 class="mt-2 font-semibold">Serah terima</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">Pengiriman, perakitan, atau instalasi dibahas sesuai jenis pekerjaan dan lokasi.</p>
        </li>
      </ol>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-slate-600">
        Peralatan event pada katalog CSK ditawarkan untuk dibeli, bukan disewakan. Jumlah minimum, kebutuhan instalasi,
        dan biaya pengiriman mengikuti jenis produk serta ruang lingkup proyek. Untuk mempercepat estimasi, sertakan
        spesifikasi yang sudah tersedia; bila belum lengkap, tim dapat membantu mengidentifikasi data yang masih diperlukan.
      </p>
    </div>
  </section>

  <Section class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Butuh estimasi harga?</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">Kirim detail kebutuhan Anda, kami balas dengan rincian biaya.</p>
    <a href={waLink('Halo, saya ingin minta estimasi harga untuk kebutuhan berikut:')}
       target="_blank" rel="noopener"
       class="mt-8 inline-flex items-center gap-2 rounded-full bg-csk-amber px-7 py-3 text-sm font-medium text-csk-black hover:bg-csk-amber/90">
      <WaIcon />Minta Penawaran
    </a>
  </Section>
</Base>
