---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWA from '../components/FloatingWA.astro';
import { site } from '../site.js';

const {
  title,
  description = 'Jasa pembuatan booth pameran, rak display custom, neon box, dan signage di Tangerang Selatan. Dikerjakan dari desain sampai pemasangan.',
  image = '/og-image.webp',
  breadcrumbs = [],
} = Astro.props;

const full = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: site.name,
  description: site.tagline,
  url: Astro.site?.href,
  image: ogImage.href,
  logo: new URL('/img/logo.webp', Astro.site).href,
  telephone: `+${site.wa}`,
  email: site.email,
  priceRange: '$$',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -6.3147379,
    longitude: 106.6936924,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: site.city,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: site.country,
  },
  areaServed: ['Tangerang Selatan', 'Tangerang', 'Jakarta', 'Depok', 'Bogor', 'Bekasi'].map((n) => ({
    '@type': 'City',
    name: n,
  })),
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.schema,
    opens: h.open,
    closes: h.close,
  })),
  sameAs: [`https://wa.me/${site.wa}`, `https://www.instagram.com/${site.ig}`, `https://www.threads.com/@${site.ig}`],
};

const crumbList = breadcrumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ href: '/', label: 'Beranda' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, Astro.site).href,
  })),
} : null;

const GA_ID = 'G-YH56PC1XQZ';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/montserrat-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-600-latin.woff2" as="font" type="font/woff2" crossorigin />

    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/assets/rak-display-bioxine/1ebe3b6d-1102-440d-80e9-8af4d444d7f2.webp" type="image/webp" fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {crumbList && <script type="application/ld+json" set:html={JSON.stringify(crumbList)} />}

    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
        <script
          is:inline
          set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${GA_ID}');

            // Track WhatsApp links consistently across the whole site.
            document.addEventListener('click', function (event) {
              const target = event.target;
              if (!(target instanceof Element)) return;

              const link = target.closest('a[href]');
              if (!link) return;

              let destination;
              try {
                destination = new URL(link.href, window.location.href);
              } catch {
                return;
              }

              const whatsappHosts = ['wa.me', 'api.whatsapp.com', 'web.whatsapp.com'];
              if (!whatsappHosts.includes(destination.hostname.toLowerCase())) return;

              // The floating WhatsApp button is already measured by the GA4
              // click event + the existing GA4 rule for link_classes "floating-wa".
              // Skip the manual event here to prevent counting the same click twice.
              if (link.classList.contains('csk-floating-wa')) return;

              const linkText = (
                link.getAttribute('aria-label') ||
                link.textContent ||
                'WhatsApp'
              ).trim().slice(0, 100);

              gtag('event', 'klik_whatsapp', {
                link_url: destination.href,
                link_text: linkText,
                page_path: window.location.pathname
              });
            }, true);
          `}
        />
      </>
    )}
  </head>
  <body class="bg-csk-white text-csk-black antialiased">
    <Header />
    <main><slot /></main>
    <Footer />
    <FloatingWA />
  </body>
</html>
