---
import { Image } from 'astro:assets';

const images = import.meta.glob([
  '/src/img/*.webp',
  '!/src/img/booth-512-slow-move-bazaar.webp',
  '!/src/img/slow-move-bazaar-signage.webp',
  '!/src/img/slow-move-bazaar-booth-detail.webp',
  '!/src/img/slow-move-bazaar-event-activity.webp',
  '!/src/img/slow-move-bazaar-installation.webp',
  '!/src/img/slow-move-bazaar-setup.webp',
], { eager: true });

const { name, alt, sizes, class: klass = '', loading = 'lazy', fetchpriority } = Astro.props;

const preserveOriginal = [
  'booth-512-slow-move-bazaar',
  'slow-move-bazaar-signage',
  'slow-move-bazaar-booth-detail',
  'slow-move-bazaar-event-activity',
  'slow-move-bazaar-installation',
  'slow-move-bazaar-setup',
].includes(name);

const mod = images[`/src/img/${name}.webp`];
if (!preserveOriginal && !mod) {
  throw new Error(`Gambar tidak ditemukan: src/img/${name}.webp`);
}

const originalSrc = `/img/${name}.webp`;
---

{preserveOriginal ? (
  <img
    src={originalSrc}
    alt={alt}
    width="1200"
    height="800"
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={klass}
  />
) : (
  <Image
    src={mod.default}
    alt={alt}
    widths={[400, 800, 1200]}
    sizes={sizes}
    loading={loading}
    {...fetchpriority && { fetchpriority }}
    decoding="async"
    class={klass}
  />
)}
