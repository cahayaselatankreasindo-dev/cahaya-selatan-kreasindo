---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import Lightbox from '../../components/Lightbox.astro';
import WaIcon from '../../components/WaIcon.astro';
import { serviceDetails, portfolio, waLink, site } from '../../site.js';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return serviceDetails.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s }: { s: (typeof serviceDetails)[number] } = Astro.props;
const crumbs = [
  { href: '/layanan', label: 'Layanan' },
  { href: `/layanan/${s.slug}`, label: s.nav },
];
const samples = (s.images ?? [])
  .map((img) => portfolio.find((p) => p.img === img))
  .filter((p): p is (typeof portfolio)[number] => Boolean(p));
const others = serviceDetails.filter((o) => o.slug !== s.slug);
const relatedGuides = (await getCollection('blog', ({ data }) => !data.draft && data.service === s.slug))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.description,
  provider: { '@type': 'LocalBusiness', '@id': new URL('/#business', Astro.site).href },
  areaServed: s.areas.map((a) => a.name),
  url: new URL(`/layanan/${s.slug}/`, Astro.site).href,
  image: new URL(s.assetImage, Astro.site).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.items.title,
    itemListElement: s.items.groups.flatMap((g) =>
      g.list.map((x) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: x,
          serviceType: g.name,
        },
      })),
    ),
  },
};
---
<Base title={s.metaTitle} description={s.description} breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />

  <Section as="h1" eyebrow="Layanan" title={s.title} lead={s.lead}>
    {s.slug === 'visual-merchandising' ? (
      <div class="mt-7">
        <a href={waLink(s.waMsg)} target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 rounded-full bg-csk-amber px-6 py-3 text-sm font-medium text-csk-black transition-colors hover:bg-csk-amber/90">
          <WaIcon />Minta Penawaran
        </a>
        <div class="mt-7 grid gap-7 md:grid-cols-[1.15fr_.85fr] md:items-start">
          <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-csk-gray/10 md:order-2">
            <div class="flex h-[380px] items-center justify-center overflow-hidden sm:h-[440px]">
              <Picture name="dress-up-gondola-supermarket-gentle-gen"
                       alt="Branding gondola Gentle Gen yang terpasang di toko dengan produk dan rak retail di sekitarnya"
                       sizes="(min-width: 768px) 440px, 90vw"
                       loading="eager"
                       fetchpriority="high"
                       class="h-full w-full object-contain" />
            </div>
            <figcaption class="bg-white px-5 py-4 text-sm text-csk-gray">Branding gondola Gentle Gen di area penjualan retail</figcaption>
          </figure>
          <div class="space-y-4 leading-relaxed text-slate-600 md:order-1">
            {s.intro.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    ) : (
      <div class="mt-10 grid gap-10 md:grid-cols-[1.15fr_.85fr]">
        <div class="space-y-4 leading-relaxed text-slate-600">
          {s.intro.map((p) => <p>{p}</p>)}
          <a href={waLink(s.waMsg)} target="_blank" rel="noopener"
             class="mt-2 inline-flex items-center gap-2 rounded-full bg-csk-amber px-6 py-3 text-sm font-medium text-csk-black transition-colors hover:bg-csk-amber/90">
            <WaIcon />Minta Penawaran
          </a>
        </div>
        {s.scope?.length > 0 && (
          <div class="rounded-2xl border border-csk-gray/20 bg-csk-gray/10 p-7">
            <p class="text-sm font-semibold text-slate-900">Ruang lingkup pengerjaan</p>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              {s.scope.map((item) => (
                <li class="flex gap-2"><span class="text-csk-amber">-</span>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </Section>

  <!-- Show genuine installed retail displays before specifications; avoid workshop and close-up-only shots. -->
  {s.slug === 'visual-merchandising' && (
    <Section class="pt-0 md:pt-0">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Contoh branding dan display yang sudah terpasang di toko</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
        Contoh display dan branding yang sudah terpasang di area penjualan, lengkap dengan produk dan konteks toko.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
          <div class="flex h-[360px] items-center justify-center bg-csk-gray/10 md:h-[430px]">
            <Picture name="floor-display-custom-kilau-nipis"
                     alt="Display promosi Kilau Nipis yang terpasang dan terisi produk di area toko retail"
                     sizes="(min-width: 640px) 520px, 90vw"
                     class="h-full w-full object-contain" />
          </div>
          <figcaption class="p-5 text-sm leading-relaxed text-csk-gray"><strong class="text-csk-black">Kilau Nipis</strong> — display promosi dengan produk di area penjualan.</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
          <div class="flex h-[360px] items-center justify-center bg-csk-gray/10 md:h-[430px]">
            <Picture name="retail-display-hanasui-installed"
                     alt="Display promosi Hanasui di area kosmetik toko, menampilkan branding dan produk pada rak retail"
                     sizes="(min-width: 640px) 520px, 90vw"
                     class="h-full w-full object-contain" />
          </div>
          <figcaption class="p-5 text-sm leading-relaxed text-csk-gray"><strong class="text-csk-black">Hanasui</strong> — display produk dan materi promosi di area kosmetik retail.</figcaption>
        </figure>
      </div>
    </Section>
  )}

  <!-- Showcase real exhibition projects early for visitors coming from Search Ads. -->
  {s.slug === 'booth-pameran' && samples.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Hasil booth pameran yang sudah kami produksi</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox aria-label={`Galeri ${s.nav}`}>
        {samples.map((p) => (
          <figure class="group overflow-hidden rounded-2xl border border-csk-gray/20">
            <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
              <Picture name={p.img} alt={p.title}
                       sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                       class="h-full w-full cursor-zoom-in object-contain transition-transform duration-500 group-hover:scale-105" />
            </div>
            <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/portofolio" class="mt-8 inline-block text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
        Lihat semua portofolio →
      </a>
    </Section>
  )}

  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{s.items.title}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.items.groups.map((g) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">{g.name}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {g.list.map((it) => (
                <li class="flex gap-2"><span class="text-csk-amber">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-csk-gray/20">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Spesifikasi &amp; Material</h2>
      <p class="mt-3 max-w-3xl text-slate-600">
        Kapabilitas produksi di workshop Serpong: material, metode fabrikasi, dan kapasitas pengerjaan untuk booth, display, signage, dan POSM.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Material tersedia</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Akrilik (bening, warna, susu)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Plat besi &amp; metal cutting</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>ACP (Aluminum Composite Panel)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>MDF / HMR</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Plywood / kayu lapis</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>LED &amp; sistem kelistrikan</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Large format printing (stiker, vinyl, banner)</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Metode fabrikasi</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Pemotongan presisi (laser / CNC)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Pengelasan rangka</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Finishing cat &amp; stiker</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Instalasi LED</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Sistem knock-down untuk event</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Kapasitas &amp; lead time</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Workshop mandiri di Serpong, Tangerang Selatan</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Melayani seluruh area Jabodetabek</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Lead time 7–14 hari kerja untuk produksi standar</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Kapasitas 50+ unit per bulan</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  {s.slug !== 'booth-pameran' && s.slug !== 'visual-merchandising' && samples.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Contoh pengerjaan</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox aria-label={`Galeri ${s.nav}`}>
        {samples.map((p) => (
          <figure class="group overflow-hidden rounded-2xl border border-csk-gray/20">
            <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
              <Picture name={p.img} alt={p.title}
                       sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                       class="h-full w-full cursor-zoom-in object-contain transition-transform duration-500 group-hover:scale-105" />
            </div>
            <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/portofolio" class="mt-8 inline-block text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
        Lihat semua portofolio →
      </a>
    </Section>
  )}

  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Pertanyaan yang sering masuk</h2>
      <dl class="mt-8 space-y-6">
        {s.faq.map((f) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <dt class="font-semibold text-slate-900">{f.q}</dt>
            <dd class="mt-2 leading-relaxed text-slate-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {s.areas?.length > 0 && (
  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Area layanan {s.title} di Jabodetabek</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.areas.map((a) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <h3 class="font-semibold">{a.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  {s.proof?.stat && (
  <Section>
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Kenapa pilih CSK untuk {s.title}</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-slate-600"><strong class="text-2xl font-bold text-csk-black">{s.proof.stat}</strong> — {s.proof.text}</p>
  </Section>
  )}

  <Section>
    <h2 class="text-2xl font-semibold tracking-tight">Layanan lainnya</h2>
    <div class="mt-6 flex flex-wrap gap-2">
      {others.map((o) => (
        <a href={`/layanan/${o.slug}`}
            class="rounded-full border border-csk-gray/30 px-4 py-1.5 text-sm text-csk-amber-text transition-colors hover:bg-csk-gray/10">
          {o.nav}
        </a>
      ))}
    </div>
  </Section>

  {relatedGuides.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Panduan terkait {s.nav}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
        Baca persiapan brief, pilihan spesifikasi, dan hal teknis sebelum meminta penawaran.
      </p>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {relatedGuides.map((guide) => (
          <a href={`/blog/${guide.id}/`}
             class="rounded-2xl border border-csk-gray/20 bg-white p-6 transition-shadow hover:shadow-md">
            <h3 class="font-semibold leading-snug text-csk-black">{guide.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{guide.data.description}</p>
            <span class="mt-4 inline-block text-sm font-medium text-csk-amber-text">Baca panduan →</span>
          </a>
        ))}
      </div>
    </Section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Lightbox />
</Base>
