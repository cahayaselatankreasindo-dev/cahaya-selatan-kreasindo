---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWA from '../components/FloatingWA.astro';
import { site } from '../site.js';
import responsiveImages from '../generated/homepage-responsive.json';

const {
  title,
  description = 'Jasa pembuatan booth pameran, rak display custom, neon box, dan signage di Tangerang Selatan. Dikerjakan dari desain sampai pemasangan.',
  image = '/og-image.webp',
  breadcrumbs = [],
  ogType = 'website',
  publishedTime,
  modifiedTime,
  waMessage,
} = Astro.props;

const full = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: site.name,
  description: site.tagline,
  url: Astro.site?.href,
  image: ogImage.href,
  logo: new URL('/img/logo.webp', Astro.site).href,
  telephone: `+${site.wa}`,
  email: site.email,
  priceRange: '$$',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -6.3147379,
    longitude: 106.6936924,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: site.city,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: site.country,
  },
  areaServed: ['Tangerang Selatan', 'Tangerang', 'Jakarta', 'Depok', 'Bogor', 'Bekasi'].map((n) => ({
    '@type': 'City',
    name: n,
  })),
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.schema,
    opens: h.open,
    closes: h.close,
  })),
  sameAs: [`https://wa.me/${site.wa}`, `https://www.instagram.com/${site.ig}`, `https://www.threads.com/@${site.ig}`],
};

const crumbList = breadcrumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ href: '/', label: 'Beranda' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, Astro.site).href,
  })),
} : null;

const GA_ID = 'G-YH56PC1XQZ';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/montserrat-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-600-latin.woff2" as="font" type="font/woff2" crossorigin />

    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/assets/rak-display-bioxine/1ebe3b6d-1102-440d-80e9-8af4d444d7f2.webp" imagesrcset={responsiveImages['/assets/rak-display-bioxine/1ebe3b6d-1102-440d-80e9-8af4d444d7f2.webp']?.srcset} imagesizes="(min-width: 768px) 33vw, 100vw" type="image/webp" fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {crumbList && <script type="application/ld+json" set:html={JSON.stringify(crumbList)} />}

    {import.meta.env.PROD && (
      <script is:inline set:html={`
        (function () {
          var ATTRIBUTION_KEY = 'csk_campaign_attribution';
          var ATTRIBUTION_PARAMS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','gbraid','wbraid','fbclid','ttclid','msclkid'];
          try {
            var saved = JSON.parse(sessionStorage.getItem(ATTRIBUTION_KEY) || '{}');
            var params = new URLSearchParams(window.location.search);
            ATTRIBUTION_PARAMS.forEach(function (key) {
              var value = params.get(key);
              if (value) saved[key] = value.slice(0, 200);
            });
            if (!saved.landing_page) saved.landing_page = window.location.pathname;
            if (!saved.referrer_host && document.referrer) {
              try {
                var referrer = new URL(document.referrer);
                if (referrer.hostname !== window.location.hostname) saved.referrer_host = referrer.hostname;
              } catch (e) {}
            }
            sessionStorage.setItem(ATTRIBUTION_KEY, JSON.stringify(saved));
          } catch (e) {}

          var GA_ID = 'G-YH56PC1XQZ';
          var CONSENT_KEY = 'csk_analytics_consent';
          function loadAnalytics() {
            if (window.__cskAnalyticsLoaded) return;
            window.__cskAnalyticsLoaded = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', GA_ID, {
              allow_google_signals: false,
              allow_ad_personalization_signals: false
            });
            var script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
            document.head.appendChild(script);
          }

          try {
            if (localStorage.getItem(CONSENT_KEY) === 'accepted') loadAnalytics();
          } catch (e) {}

          window.cskAcceptAnalytics = function () {
            try { localStorage.setItem(CONSENT_KEY, 'accepted'); } catch (e) {}
            loadAnalytics();
            var banner = document.getElementById('csk-cookie-banner');
            if (banner) banner.hidden = true;
          };
          window.cskRejectAnalytics = function () {
            try { localStorage.setItem(CONSENT_KEY, 'rejected'); } catch (e) {}
            if (typeof window.gtag === 'function') {
              window.gtag('consent', 'update', {
                analytics_storage: 'denied',
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied'
              });
            }
            var banner = document.getElementById('csk-cookie-banner');
            if (banner) banner.hidden = true;
          };
          window.cskShowCookieSettings = function () {
            var banner = document.getElementById('csk-cookie-banner');
            if (banner) banner.hidden = false;
          };
          document.addEventListener('DOMContentLoaded', function () {
            var banner = document.getElementById('csk-cookie-banner');
            var choice = '';
            try { choice = localStorage.getItem(CONSENT_KEY) || ''; } catch (e) {}
            if (banner && !choice) banner.hidden = false;
          });
        })();

        document.addEventListener('click', function (event) {
          const target = event.target;
          if (!(target instanceof Element) || typeof window.gtag !== 'function') return;
          const link = target.closest('a[href]');
          if (!link) return;

          let destination;
          try { destination = new URL(link.href, window.location.href); } catch { return; }

          if (destination.origin === window.location.origin &&
              destination.pathname.startsWith('/layanan/') &&
              window.location.pathname.startsWith('/blog/')) {
            window.gtag('event', 'klik_layanan', {
              page_path: window.location.pathname,
              service_path: destination.pathname,
              cta_location: link.dataset.ctaLocation || 'article_body'
            });
          }

          const whatsappHosts = ['wa.me', 'api.whatsapp.com', 'web.whatsapp.com'];
          if (!whatsappHosts.includes(destination.hostname.toLowerCase())) return;

          const linkText = (
            link.getAttribute('aria-label') ||
            link.textContent ||
            'WhatsApp'
          ).trim().slice(0, 100);

          window.gtag('event', 'klik_whatsapp', {
            link_url: destination.href,
            link_text: linkText,
            page_path: window.location.pathname,
            cta_location: link.dataset.ctaLocation || (link.closest('footer') ? 'footer' : link.closest('header') ? 'header' : link.classList.contains('csk-floating-wa') ? 'floating' : 'content')
          });
        }, true);
      `} />
    )}
  </head>
  <body class="bg-csk-white text-csk-black antialiased">
    <Header />
    <main><slot /></main>
    <Footer />
    <FloatingWA message={waMessage} />
    <aside id="csk-cookie-banner" hidden class="fixed inset-x-3 bottom-3 z-[120] mx-auto max-w-3xl rounded-xl border border-csk-gray/20 bg-white p-4 shadow-2xl sm:inset-x-6 sm:bottom-6 sm:flex sm:items-center sm:gap-5 sm:p-5">
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold text-csk-black">Pengaturan analitik</p>
        <p class="mt-1 text-xs leading-relaxed text-csk-gray">Kami menggunakan Google Analytics untuk memahami penggunaan website dan memperbaiki layanan. Analitik hanya dimuat jika Anda menyetujuinya. Pilihan ini dapat diubah kapan saja melalui tautan Pengaturan Cookie di footer.</p>
      </div>
      <div class="mt-3 flex shrink-0 flex-wrap gap-2 sm:mt-0">
        <button type="button" onclick="window.cskRejectAnalytics()" class="min-h-10 rounded-lg border border-csk-gray/25 px-4 py-2 text-xs font-semibold text-csk-black">Tolak</button>
        <button type="button" onclick="window.cskAcceptAnalytics()" class="min-h-10 rounded-lg bg-csk-black px-4 py-2 text-xs font-semibold text-white">Setuju analitik</button>
      </div>
    </aside>
  </body>
</html>
