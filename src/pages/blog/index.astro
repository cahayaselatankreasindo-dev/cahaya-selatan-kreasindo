---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import { getCollection } from 'astro:content';
import { serviceDetails } from '../../site.js';

const articles = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id));
const groups = serviceDetails
  .map((service) => ({ service, articles: articles.filter((a) => a.data.service === service.slug) }))
  .filter(({ articles }) => articles.length > 0);
const misc = articles.filter((a) => !a.data.service);
const crumbs = [{ href: '/blog', label: 'Blog & Panduan' }];
const dateLabel = (date) => new Intl.DateTimeFormat('id-ID', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta',
}).format(date);
---
<Base
  title="Blog & Panduan Produksi untuk Brand dan Bisnis"
  description="Panduan praktis Cahaya Selatan Kreasindo tentang persiapan booth pameran, rak display dan gondola, POSM, neon box, dan visual merchandising retail."
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />
  <Section as="h1" eyebrow="Blog & Panduan CSK"
    title="Panduan produksi untuk brand, retail, dan event"
    lead="Persiapan brief, pilihan material, dan hal teknis yang perlu dipertimbangkan sebelum memesan booth, display, signage, atau branding toko.">
    <nav aria-label="Kategori artikel" class="mt-8 flex flex-wrap gap-2">
      {groups.map(({ service }) => (
        <a href={`#${service.slug}`}
          class="rounded-full border border-csk-gray/25 px-4 py-2 text-sm font-medium text-csk-black transition-colors hover:border-csk-amber hover:bg-csk-gray/10">
          {service.nav}
        </a>
      ))}
    </nav>
  </Section>

  {groups.map(({ service, articles: items }) => (
    <section id={service.slug} class="mx-auto max-w-6xl scroll-mt-24 px-5 pb-14">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-csk-gray/20 pb-4">
        <h2 class="text-2xl font-semibold tracking-tight text-csk-black">{service.nav}</h2>
        <a href={`/layanan/${service.slug}/`} class="text-sm font-medium text-csk-amber-text hover:underline">
          Lihat layanan →
        </a>
      </div>
      <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((entry) => (
          <article class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
            <a href={`/blog/${entry.id}/`} class="group block">
              <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
                {entry.data.cover
                  ? <Picture name={entry.data.cover} alt={entry.data.coverAlt || entry.data.title}
                      sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  : entry.data.image
                    ? <img src={entry.data.image} alt={entry.data.title} loading="lazy" decoding="async"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    : null}
              </div>
              <div class="p-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-csk-amber-text">{entry.data.category || service.nav}</p>
                <h3 class="mt-2 text-lg font-semibold leading-snug text-csk-black group-hover:text-csk-amber-text">
                  {entry.data.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{entry.data.description}</p>
                <p class="mt-5 text-xs text-csk-gray">
                  <time datetime={entry.data.pubDate.toISOString().slice(0, 10)}>{dateLabel(entry.data.pubDate)}</time>
                  <span aria-hidden="true"> · </span>Baca panduan →
                </p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}

  {misc.length > 0 && (
    <Section title="Artikel lainnya">
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {misc.map((entry) => (
          <a href={`/blog/${entry.id}/`} class="block rounded-xl border border-csk-gray/20 p-5 hover:bg-csk-gray/10">
            <h3 class="font-semibold text-csk-black">{entry.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{entry.data.description}</p>
          </a>
        ))}
      </div>
    </Section>
  )}

  <Section class="border-t border-csk-gray/20">
    <div class="rounded-2xl bg-csk-gray/10 p-7 md:p-10">
      <h2 class="text-2xl font-semibold">Ada proyek produksi yang sedang direncanakan?</h2>
      <p class="mt-3 max-w-2xl text-slate-600">Cek kapabilitas dan hasil pekerjaan CSK untuk menentukan kebutuhan sebelum meminta penawaran.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/layanan/" class="rounded-full bg-csk-amber px-6 py-3 text-sm font-semibold text-csk-black">Lihat layanan</a>
        <a href="/portofolio/" class="rounded-full border border-csk-gray/30 px-6 py-3 text-sm font-semibold text-csk-black">Lihat portofolio</a>
      </div>
    </div>
  </Section>
</Base>
