---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import Lightbox from '../../components/Lightbox.astro';
import WaIcon from '../../components/WaIcon.astro';
import { serviceDetails, portfolio, waLink, site } from '../../site.js';

export function getStaticPaths() {
  return serviceDetails.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s }: { s: (typeof serviceDetails)[number] } = Astro.props;
const crumbs = [
  { href: '/layanan', label: 'Layanan' },
  { href: `/layanan/${s.slug}`, label: s.nav },
];
const samples = (s.images ?? [])
  .map((img) => portfolio.find((p) => p.img === img))
  .filter((p): p is (typeof portfolio)[number] => Boolean(p));
const others = serviceDetails.filter((o) => o.slug !== s.slug);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={s.metaTitle} description={s.description} breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />

  <Section as="h1" eyebrow="Layanan" title={s.title} lead={s.lead}>
    <div class="mt-10 grid gap-10 md:grid-cols-[1.15fr_.85fr]">
      <div class="space-y-4 leading-relaxed text-slate-600">
        {s.intro.map((p) => <p>{p}</p>)}
        <a href={waLink(s.waMsg)} target="_blank" rel="noopener"
           class="mt-2 inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-600">
          <WaIcon />Minta Penawaran
        </a>
      </div>
      <div class="rounded-2xl border border-brand-100 bg-brand-50/50 p-7">
        <p class="text-sm font-semibold text-slate-900">Ruang lingkup pengerjaan</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li class="flex gap-2"><span class="text-brand-400">-</span>Survei dan pembahasan kebutuhan</li>
          <li class="flex gap-2"><span class="text-brand-400">-</span>Gambar kerja sebelum produksi</li>
          <li class="flex gap-2"><span class="text-brand-400">-</span>Produksi di workshop Serpong</li>
          <li class="flex gap-2"><span class="text-brand-400">-</span>Pengiriman dan pemasangan sesuai lokasi</li>
        </ul>
      </div>
    </div>
  </Section>

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{s.items.title}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.items.groups.map((g) => (
          <div class="rounded-2xl border border-brand-100 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-600">{g.name}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {g.list.map((it) => (
                <li class="flex gap-2"><span class="text-brand-400">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {samples.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Contoh pengerjaan</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox aria-label={`Galeri ${s.nav}`}>
        {samples.map((p) => (
          <figure class="group overflow-hidden rounded-2xl border border-brand-100">
            <div class="aspect-4/3 overflow-hidden bg-brand-50">
              <Picture name={p.img} alt={p.title}
                       sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                       class="h-full w-full cursor-zoom-in object-contain transition-transform duration-500 group-hover:scale-105" />
            </div>
            <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/portofolio" class="mt-8 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
        Lihat semua portofolio →
      </a>
    </Section>
  )}

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Pertanyaan yang sering masuk</h2>
      <dl class="mt-8 space-y-6">
        {s.faq.map((f) => (
          <div class="rounded-2xl border border-brand-100 bg-white p-6">
            <dt class="font-semibold text-slate-900">{f.q}</dt>
            <dd class="mt-2 leading-relaxed text-slate-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Section>
    <h2 class="text-2xl font-semibold tracking-tight">Layanan lainnya</h2>
    <div class="mt-6 flex flex-wrap gap-2">
      {others.map((o) => (
        <a href={`/layanan/${o.slug}`}
           class="rounded-full border border-brand-200 px-4 py-1.5 text-sm text-brand-700 transition-colors hover:bg-brand-50">
          {o.nav}
        </a>
      ))}
    </div>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Lightbox />
</Base>
