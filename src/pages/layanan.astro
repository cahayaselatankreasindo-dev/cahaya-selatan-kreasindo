---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { serviceDetails, products, waLink } from '../site.js';
import WaIcon from '../components/WaIcon.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
---
<Base
  title="Layanan POSM, Rak Display, Booth Pameran & Signage"
  description="Layanan Cahaya Selatan Kreasindo: produksi POSM, rak display custom dan gondola, booth pameran, neon box dan signage, visual merchandising, serta sewa peralatan event di Jabodetabek."
  breadcrumbs={[{ href: '/layanan', label: 'Layanan' }]}
>
  <Breadcrumbs items={[{ href: '/layanan', label: 'Layanan' }]} />
  <Section as="h1" eyebrow="Layanan" title="Solusi display yang tepat untuk bisnis Anda"
           lead="Enam lini pekerjaan, semuanya custom mengikuti ukuran lokasi, karakter produk, dan identitas brand Anda. Pilih yang paling dekat dengan kebutuhan Anda.">
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {serviceDetails.map((s) => (
        <a href={`/layanan/${s.slug}`}
           class="group rounded-2xl border border-brand-100 p-7 transition-shadow hover:shadow-md">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <ServiceIcon name={s.icon} />
          </span>
          <h2 class="mt-4 text-lg font-semibold">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.lead}</p>
          <span class="mt-3 inline-block text-sm font-medium text-brand-700 group-hover:text-brand-800">
            Selengkapnya &rarr;
          </span>
        </a>
      ))}
    </div>
  </Section>

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Produk &amp; peralatan</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <div class="rounded-2xl border border-brand-100 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-600">{p.group}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {p.items.map((it) => (
                <li class="flex gap-2"><span class="text-brand-400">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Section class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Butuh estimasi harga?</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">Kirim detail kebutuhan Anda, kami balas dengan rincian biaya.</p>
    <a href={waLink('Halo, saya ingin minta estimasi harga untuk kebutuhan berikut:')}
       target="_blank" rel="noopener"
       class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-medium text-white hover:bg-brand-600">
      <WaIcon />Minta Penawaran
    </a>
  </Section>
</Base>
