---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Picture from '../components/Picture.astro';
import { site, services, waLink, portfolio, areas } from '../site.js';

const heroImgs = [
  ['jasa-tirta-booth-pameran', 'Booth pameran Jasa Tirta II'],
  ['potens-gondola-supermarket', 'Gondola supermarket Potens'],
  ['jnt-cargo-neon-box', 'Neon box J&T Cargo'],
  ['booth-barn-mall', 'Booth aktivasi bertema barn di atrium mall'],
];
---
<Base
  title="Jasa Booth Pameran & Rak Display"
  description="Cahaya Selatan Kreasindo, jasa pembuatan booth pameran, rak display custom, neon box, dan signage di Tangerang Selatan. Dikerjakan sendiri dari desain sampai pemasangan."
>
  <section class="relative overflow-hidden border-b border-brand-100 bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-[1.1fr_.9fr] md:py-28">
      <div>
        <h1 class="text-4xl font-semibold leading-[1.1] tracking-tight md:text-6xl">
          Stand event &amp; booth pameran<br class="hidden md:block" />
          <span class="text-brand-600">yang bikin brand Anda dilirik.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
          {site.name} mengerjakan rak display custom, neon box, signage, dan booth pameran —
          dari desain sampai pemasangan di lokasi.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={waLink()} target="_blank" rel="noopener"
             class="rounded-full bg-brand-500 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-600">
            Konsultasi Gratis
          </a>
          <a href="/portofolio"
             class="rounded-full border border-brand-200 px-6 py-3 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50">
            Lihat Portofolio
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 self-center">
        {heroImgs.map(([img, alt], i) => (
          <Picture
            name={img}
            alt={alt}
            sizes="(min-width: 768px) 220px, 45vw"
            loading={i < 2 ? 'eager' : 'lazy'}
            class:list={[
              'aspect-4/3 w-full rounded-2xl border border-brand-100 object-cover',
              i % 3 === 0 ? 'md:translate-y-4' : '',
            ]}
          />
        ))}
      </div>
    </div>
  </section>

  <Section eyebrow="Layanan" title="Solusi display yang tepat untuk bisnis Anda"
           lead="Empat hal yang paling sering dipesan klien kami.">
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {services.map((s, i) => (
        <article class="rounded-2xl border border-brand-100 bg-white p-7 transition-shadow hover:shadow-md">
          <span class="text-sm font-semibold text-brand-500">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm font-medium text-brand-700">{s.lead}</p>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.body}</p>
        </article>
      ))}
    </div>
    <a href="/layanan" class="mt-8 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
      Detail layanan &amp; daftar produk →
    </a>
  </Section>

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-3">
      {[
        ['Presisi & Kokoh', 'Pengerjaan rapi, material tahan lama, finishing bersih.'],
        ['Satu Pintu', 'Desain, produksi, kirim, sampai instalasi ditangani satu tim.'],
        ['Tepat Waktu', 'Jadwal event tidak menunggu — kami kerja sesuai deadline.'],
      ].map(([t, d]) => (
        <div>
          <h2 class="text-base font-semibold">{t}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <Section eyebrow="Portofolio" title="Sebagian pekerjaan kami"
           lead="Booth pameran, rak display ritel, neon box, dan signage untuk berbagai brand.">
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {portfolio.slice(0, 6).map((p) => (
        <figure class="group overflow-hidden rounded-2xl border border-brand-100">
          <div class="aspect-4/3 overflow-hidden bg-brand-50">
            <Picture name={p.img} alt={p.title} sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                     class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
        </figure>
      ))}
    </div>
    <a href="/portofolio" class="mt-8 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
      Lihat semua portofolio →
    </a>
  </Section>

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Area layanan</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Berbasis di Serpong, melayani Jabodetabek. Survei lokasi dan pemasangan dilakukan tim sendiri.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {areas.map((a) => (
          <li class="rounded-full border border-brand-200 bg-white px-4 py-1.5 text-sm text-brand-700">{a.name}</li>
        ))}
      </ul>
      <a href="/area-layanan" class="mt-6 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
        Detail area layanan →
      </a>
    </div>
  </section>

  <Section class="text-center">
    <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">
      Punya rencana event atau mau renovasi display toko?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">
      Kirim ukuran, foto lokasi, atau referensi desain — kami bantu hitung estimasinya.
    </p>
    <a href={waLink()} target="_blank" rel="noopener"
       class="mt-8 inline-block rounded-full bg-brand-500 px-7 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-600">
      Chat WhatsApp {site.waDisplay}
    </a>
  </Section>
</Base>
