---
import { getCollection, render } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WaIcon from '../components/WaIcon.astro';
import Picture from '../components/Picture.astro';
import { site, waLink, portfolio } from '../site.js';

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = entry.data;
const slug = entry.id;
const waMessage = `Halo CSK, saya membaca panduan "${fm.title}" dan ingin konsultasi proyek:\n\nJenis kebutuhan: \nUkuran: \nJumlah unit/outlet: \nLokasi: \nTarget waktu: `;

const crumbs = [
  { href: '/blog', label: 'Panduan' },
  { href: `/blog/${slug}`, label: fm.title },
];

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.id !== slug)
  .sort((a, b) => Number(b.data.category === fm.category) - Number(a.data.category === fm.category))
  .slice(0, 2);

// Link each guide to documented CSK projects, not generic gallery thumbnails.
// These project keys are verified against the existing portfolio in src/site.js.
const projectImagesByArticle = {
  'checklist-brief-booth-pameran-custom': [
    'booth-pameran-custom-jakarta-jasa-tirta',
    'booth-pameran-custom-perfetto-jakarta',
  ],
  'panduan-neon-box-vs-huruf-timbul': [
    'neon-box-custom-jnt-cargo-tangerang',
    'huruf-timbul-akrilik-gorisa',
  ],
  'checklist-produksi-posm-banyak-outlet': [
    'nomor-meja-akrilik-custom-teh-pucuk',
    'display-light-box-custom-kredivo',
  ],
  'floor-display-vs-counter-display-posm': [
    'floor-display-custom-kilau-nipis',
    'nomor-meja-akrilik-custom-teh-pucuk',
  ],
  'panduan-display-gondola-visual-merchandising': [
    'dress-up-gondola-supermarket-gentle-gen',
    'floor-display-custom-kilau-nipis',
  ],
  'memilih-rak-display-custom-gondola-toko': [
    'gondola-supermarket-custom-potens',
    'dress-up-gondola-supermarket-gentle-gen',
  ],
  'rak-display-kecantikan-minimarket': [
    'rak-display-custom-halowell',
    'promotional-display-custom-bioxine',
  ],
};
const relatedProjects = (projectImagesByArticle[slug] ?? [])
  .map((img) => portfolio.find((p) => p.img === img))
  .filter(Boolean);

const articleUrl = new URL(`/blog/${slug}/`, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  headline: fm.title,
  description: fm.description,
  inLanguage: 'id-ID',
  articleSection: fm.category || 'Panduan Produksi',
  datePublished: fm.pubDate.toISOString(),
  ...(fm.updatedDate && { dateModified: fm.updatedDate.toISOString() }),
  image: new URL(fm.image, Astro.site).href,
  author: { '@type': 'Organization', name: fm.author, url: new URL('/tentang/', Astro.site).href },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: Astro.site?.href,
    logo: { '@type': 'ImageObject', url: new URL('/img/logo.webp', Astro.site).href },
  },
};

const faq = fm.faq ?? [];
const faqSchema = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' };
---

<Base
  waMessage={waMessage}
  title={fm.title}
  description={fm.description}
  image={fm.image}
  breadcrumbs={crumbs}
  ogType="article"
  publishedTime={fm.pubDate.toISOString()}
  modifiedTime={fm.updatedDate?.toISOString()}
>
  <Breadcrumbs items={crumbs} />

  <article class="mx-auto max-w-3xl px-5 pt-10 md:pt-14">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-amber-text">{fm.category || 'Panduan Produksi'}</p>
    <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-csk-black md:text-4xl">{fm.title}</h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate-600">{fm.description}</p>
    <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1 text-xs text-csk-gray">
      <span>Diterbitkan oleh {fm.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={fm.pubDate.toISOString()}>{fm.pubDate.toLocaleDateString('id-ID', dateOptions)}</time>
      {fm.updatedDate && (
        <span>· Diperbarui <time datetime={fm.updatedDate.toISOString()}>{fm.updatedDate.toLocaleDateString('id-ID', dateOptions)}</time></span>
      )}
    </div>

    <figure class="mt-8 overflow-hidden rounded-2xl border border-csk-gray/15 bg-csk-gray/10">
      <div class="aspect-[16/10] overflow-hidden sm:aspect-[16/8]">
        <img
          src={fm.image}
          alt={fm.imageAlt || fm.title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </div>
      <figcaption class="px-5 py-3 text-xs leading-relaxed text-csk-gray">
        Dokumentasi visual terkait pekerjaan produksi dan branding CSK.
      </figcaption>
    </figure>

    <div class="prose prose-slate mt-10 max-w-none
      prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-csk-black
      prose-h2:mt-12 prose-h2:border-b prose-h2:border-csk-gray/15 prose-h2:pb-3
      prose-p:leading-relaxed prose-p:text-csk-gray
      prose-li:text-csk-gray
      prose-strong:text-csk-black
      prose-a:font-medium prose-a:text-csk-amber-text
      prose-blockquote:border-csk-amber prose-blockquote:text-csk-gray
      prose-img:rounded-xl
      prose-th:text-csk-black
      prose-table:text-sm">
      <Content />
    </div>
  </article>

  {relatedProjects.length > 0 && (
    <section class="mx-auto mt-12 max-w-3xl px-5" aria-labelledby="related-projects-heading">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-csk-amber-text">Bukti pengerjaan CSK</p>
      <h2 id="related-projects-heading" class="mt-3 text-2xl font-semibold tracking-tight text-csk-black">
        Lihat contoh proyek terkait
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-csk-gray">
        Dokumentasi pekerjaan yang relevan dengan topik panduan ini. Pilih foto untuk melihatnya dalam portofolio.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {relatedProjects.map((project) => (
          <a href={`/portofolio/#proyek-${project.img}`}
             class="group overflow-hidden rounded-2xl border border-csk-gray/20 bg-white hover:border-csk-amber">
            <div class="aspect-[4/3] overflow-hidden bg-csk-gray/10">
              <Picture name={project.img} alt={project.title}
                       sizes="(min-width: 640px) 330px, 90vw"
                       class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold leading-snug text-csk-black group-hover:text-csk-amber-text">{project.title}</h3>
              <span class="mt-2 inline-block text-xs font-medium text-csk-amber-text">
                Lihat dokumentasi di portofolio &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto mt-16 max-w-3xl px-5">
    <div class="rounded-2xl bg-csk-black p-7 text-white sm:p-9">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-amber">Punya proyek yang perlu diproduksi?</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight">Diskusikan kebutuhan dengan CSK</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/75">
        Kirim kebutuhan, ukuran, lokasi, dan target pekerjaan. Tim kami bisa membantu menilai langkah produksi yang sesuai.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {fm.relatedService && (
          <a href={fm.relatedService} data-cta-location="article_end"
             class="inline-flex items-center rounded-full bg-csk-amber px-5 py-3 text-sm font-semibold text-csk-black hover:bg-csk-amber/90">
            Lihat layanan terkait &rarr;
          </a>
        )}
        <a href={waLink(waMessage)} data-cta-location="article_end"
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-3 text-sm font-medium text-white hover:bg-white/10">
          <WaIcon /> Konsultasi WhatsApp
        </a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="mx-auto max-w-3xl px-5 pt-14">
      <h2 class="text-2xl font-semibold tracking-tight">Baca panduan lainnya</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {related.map((post) => (
          <a href={`/blog/${post.id}/`}
             class="group rounded-xl border border-csk-gray/20 bg-white p-5 hover:border-csk-amber">
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-csk-amber-text">{post.data.category || 'Panduan'}</span>
            <h3 class="mt-2 font-semibold leading-snug text-csk-black group-hover:text-csk-amber-text">{post.data.title}</h3>
            <span class="mt-3 inline-block text-sm text-csk-gray">Baca artikel &rarr;</span>
          </a>
        ))}
      </div>
      <a href="/blog/" class="mt-6 inline-block text-sm font-medium text-csk-amber-text hover:underline">Lihat semua panduan &rarr;</a>
    </section>
  )}

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Base>
