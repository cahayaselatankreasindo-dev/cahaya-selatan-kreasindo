---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { services, products, waLink } from '../site.js';
import WaIcon from '../components/WaIcon.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
---
<Base
  title="Rak Display Custom, Neon Box & Booth Pameran"
  description="Layanan Cahaya Selatan Kreasindo: rak display custom, gondola supermarket, neon box, huruf timbul, papan nama, booth pameran, dan sewa peralatan event di Jabodetabek."
  breadcrumbs={[{ href: '/layanan', label: 'Layanan' }]}
>
  <Breadcrumbs items={[{ href: '/layanan', label: 'Layanan' }]} />
  <Section as="h1" eyebrow="Layanan" title="Solusi display yang tepat untuk bisnis Anda"
           lead="Semua dikerjakan custom mengikuti ukuran lokasi, karakter produk, dan identitas brand Anda.">
    <div class="mt-10 space-y-4">
      {services.map((s) => (
        <article class="grid gap-4 rounded-2xl border border-brand-100 p-7 md:grid-cols-[auto_1fr] md:gap-8">
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
          <ServiceIcon name={s.icon} class="h-7 w-7" />
        </span>
          <div>
            <h3 class="text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 font-medium text-brand-700">{s.lead}</p>
            <p class="mt-2 max-w-2xl leading-relaxed text-slate-600">{s.body}</p>
            <a href="/portofolio" class="mt-3 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
              Lihat contoh pengerjaan →
            </a>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <section class="border-y border-brand-100 bg-brand-50/40">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Produk &amp; peralatan</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {products.map((p) => (
          <div class="rounded-2xl border border-brand-100 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-600">{p.group}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {p.items.map((it) => (
                <li class="flex gap-2"><span class="text-brand-400">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Section class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Butuh estimasi harga?</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">Kirim detail kebutuhan Anda, kami balas dengan rincian biaya.</p>
    <a href={waLink('Halo, saya ingin minta estimasi harga untuk kebutuhan berikut:')}
       target="_blank" rel="noopener"
       class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-medium text-white hover:bg-brand-600">
      <WaIcon />Minta Penawaran
    </a>
  </Section>
</Base>
