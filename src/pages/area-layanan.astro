---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import WaIcon from '../components/WaIcon.astro';
import { site, areas, waLink } from '../site.js';

const mapQ = encodeURIComponent(site.address);
---

<Base
  title="Area Layanan CSK | Tangerang Selatan & Jabodetabek"
  description="Cahaya Selatan Kreasindo melayani produksi booth pameran, retail display, POSM, neon box, dan signage untuk Tangerang Selatan, Tangerang, Jakarta, Depok, Bogor, dan Bekasi."
  breadcrumbs={[{ href: '/area-layanan/', label: 'Area Layanan' }]}
>
  <Breadcrumbs items={[{ href: '/area-layanan/', label: 'Area Layanan' }]} />

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 h-[30rem] w-[30rem] rotate-45 border border-csk-amber/15"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:py-20 lg:gap-16 lg:px-8 lg:py-24">
      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-csk-amber">Area Layanan</p>
        <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Workshop di Serpong. Menjangkau Jabodetabek.
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-7 text-white/70 sm:text-base">
          Produksi dilakukan di workshop Cahaya Selatan Kreasindo, kemudian disiapkan untuk pengiriman dan pemasangan sesuai lokasi serta jadwal pekerjaan.
        </p>
        <a href={waLink('Halo CSK, saya ingin konsultasi kebutuhan produksi untuk lokasi:')}
           target="_blank" rel="noopener"
           data-cta-location="area_hero"
           class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95">
          <WaIcon />Tanyakan Jangkauan Layanan
        </a>
      </div>
      <figure class="relative ml-4 overflow-hidden border border-white/10 bg-white/5 sm:ml-8">
        <div class="aspect-[5/4]">
          <Picture
            name="gate-entrance-custom-le-minerale"
            alt="Gate entrance Le Minerale hasil produksi dan instalasi CSK"
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 768px) 52vw, 100vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-csk-black/75 via-transparent to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-csk-amber">Produksi & Instalasi</p>
          <p class="mt-2 text-lg font-bold text-white sm:text-2xl">Dari workshop ke lokasi pekerjaan.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 py-16 md:py-20">
      <div class="mb-10 max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Jangkauan Produksi</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">
          Area yang kami layani.
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-csk-gray sm:text-base">
          Workshop kami berlokasi di {site.street}. Produksi, pengiriman, dan pemasangan dikerjakan oleh tim CSK sesuai ruang lingkup pekerjaan.
        </p>
      </div>
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {areas.map((a) => (
          <article class="border-t-2 border-csk-amber pt-5">
            <h3 class="text-lg font-bold text-csk-black">{a.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-csk-gray">{a.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-csk-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-20">
      <div class="overflow-hidden border border-csk-gray/20 bg-white">
        <iframe
          title="Lokasi workshop Cahaya Selatan Kreasindo di Serpong, Tangerang Selatan"
          class="h-[380px] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://maps.google.com/maps?q=${mapQ}&output=embed`}
        ></iframe>
        <p class="border-t border-csk-gray/20 px-5 py-3 text-sm text-csk-gray">
          Workshop: {site.street}, {site.city}
        </p>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Workshop CSK</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">Produksi berpusat di Tangerang Selatan.</h2>
        <p class="mt-4 text-sm leading-relaxed text-csk-gray">
          Workshop di Serpong menjadi pusat pengerjaan, pemeriksaan kualitas, dan persiapan pengiriman. Untuk kunjungan, silakan buat janji terlebih dahulu agar tim terkait tersedia.
        </p>
        <address class="mt-5 not-italic text-sm leading-7 text-csk-gray">
          <strong class="text-csk-black">Cahaya Selatan Kreasindo</strong><br />
          Jl. Doel Silem No. 45, Rawa Mekar Jaya, Serpong<br />
          Tangerang Selatan, Banten 15310
        </address>
      </div>
    </div>
  </section>

  <section class="bg-csk-black text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:grid-cols-2 md:py-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">Kawasan Komersial</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">Mendukung kebutuhan brand dan bisnis.</h2>
        <p class="mt-4 text-sm leading-relaxed text-white/65">
          Kami melayani kebutuhan produksi untuk kawasan BSD City, Alam Sutera, Gading Serpong, PIK, Thamrin, Sudirman, Kuningan, hingga kawasan bisnis lain di Jakarta.
        </p>
      </div>
      <div class="border-t border-white/20 pt-5">
        <h3 class="text-base font-bold text-csk-amber">Di luar Jabodetabek?</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Untuk booth pameran dan rak display, produksi tetap dapat dilakukan di workshop lalu dikirim ke kota tujuan. Kebutuhan pemasangan dan biaya mobilisasi dibahas berdasarkan lokasi serta jadwal.
        </p>
        <a href={waLink('Halo CSK, saya ingin bertanya jangkauan layanan untuk lokasi:')}
           target="_blank" rel="noopener"
           class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-sm bg-csk-amber px-5 py-2.5 text-sm font-bold text-csk-black transition-colors hover:brightness-95">
          <WaIcon />Tanyakan Jangkauan Layanan
        </a>
      </div>
    </div>
  </section>
</Base>
