---
import { site, waLink } from '../site.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/layanan', label: 'Layanan' },
  { href: '/portofolio', label: 'Portofolio' },
  { href: '/area-layanan', label: 'Area' },
];
import WaIcon from './WaIcon.astro';
---
<header class="sticky top-0 z-50 border-b border-csk-gray/15 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/img/logo.webp" alt={site.name} width="120" height="120" class="h-9 w-9 rounded-lg object-cover" />
        <span class="text-sm font-semibold leading-tight tracking-tight text-csk-black">
        Cahaya Selatan<br /><span class="text-csk-black">Kreasindo</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={[
            'rounded-full px-3 py-2 text-sm transition-colors',
            path === n.href ? 'bg-csk-white font-medium text-csk-black' : 'text-csk-gray hover:text-csk-black',
          ]}
        >{n.label}</a>
      ))}
      <a href={waLink()} target="_blank" rel="noopener"
         class="ml-1 inline-flex items-center gap-2 rounded-full bg-csk-black px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-csk-black/80">
        <WaIcon class="h-3.5 w-3.5" />Hubungi Kami
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-csk-gray/20 p-2 text-csk-black">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-48 rounded-xl border border-csk-gray/15 bg-white p-2 shadow-lg">
        {nav.map((n) => (
          <a href={n.href} class="block rounded-lg px-3 py-2 text-sm text-csk-gray hover:bg-csk-white">{n.label}</a>
        ))}
        <a href={waLink()} target="_blank" rel="noopener"
           class="mt-1 flex items-center justify-center gap-2 rounded-lg bg-csk-black px-3 py-2 text-sm font-medium text-white"><WaIcon class="h-3.5 w-3.5" />WhatsApp</a>
      </div>
    </details>
  </div>
</header>
