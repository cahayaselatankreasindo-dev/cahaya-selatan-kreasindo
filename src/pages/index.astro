---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import WaIcon from '../components/WaIcon.astro';
import Lightbox from '../components/Lightbox.astro';
import AssetImage from '../components/AssetImage.astro';

import { serviceDetails, waLink, areas } from '../site.js';

const featuredPortfolio = [
  {
    src: '/assets/Booth Exhibition/27528bda-fd77-4755-b817-f40d8eab7595.jpg',
    title: 'Booth Pameran Custom',
    cat: 'Booth & Pameran',
  },
  {
    src: '/assets/Booth Exhibition/860D62FD-8DAB-4AF8-86D2-0136FB71A980.jpg',
    title: 'Booth Aktivasi Brand',
    cat: 'Booth & Pameran',
  },
  {
    src: '/assets/Rak Display bioxine/ACC5159E-1571-42EA-9D56-9BD9D7AF0239.jpg',
    title: 'Rak Display Bioxsine',
    cat: 'Rak Display',
  },
  {
    src: '/assets/Rak Display bioxine/588D149F-B44C-47CD-B288-F68CED3C6C2C.jpg',
    title: 'Rak Display Bioxsine',
    cat: 'Rak Display',
  },
  {
    src: '/assets/Rak Display PVC/Floor display akrilik pop up Boga.jpg',
    title: 'Floor Display Akrilik Pop Up Boga',
    cat: 'Rak Display',
  },
  {
    src: '/assets/Proses produksi rak display dan exhibiton booth event/Rak kayu Olike.jpg',
    title: 'Rak Kayu Olike',
    cat: 'Rak Display',
  },
];
---
<Base
      title="Jasa Booth Pameran & Rak Display"
      description="Cahaya Selatan Kreasindo, jasa pembuatan booth pameran, rak display custom, neon box, dan signage di Tangerang Selatan. Dikerjakan sendiri dari desain sampai pemasangan."
>
      <section class="border-b border-slate-200 bg-white">
            <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:py-20 md:grid-cols-[0.9fr_1.1fr] md:items-center md:gap-16 md:py-24">
                  <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Cahaya Selatan Kreasindo</p>
                        <h1 class="mt-4 max-w-xl text-4xl font-semibold leading-[1.12] tracking-tight text-ink sm:text-5xl md:text-6xl">
                              Kontraktor Booth Pameran &amp; Display Custom
                        </h1>
                        <p class="mt-6 max-w-lg text-base leading-8 text-slate-600 sm:text-lg">
                              Produksi booth pameran, rak display, dan fabrikasi custom dari desain sampai pemasangan di lokasi.
                        </p>
                        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                              <a href="/portofolio"
                                     class="inline-flex justify-center rounded-full bg-brand-500 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-600">
                                    Lihat Portofolio
                              </a>
                              <a href={waLink()} target="_blank" rel="noopener"
                                     class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-200 px-6 py-3 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50">
                                    <WaIcon />Konsultasi Proyek
                              </a>
                        </div>
                  </div>

                  <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
                        <div class="aspect-square overflow-hidden">
                              <AssetImage
                                    src="/assets/Booth Exhibition/2e405837-24da-4f2c-bfb1-d7263f1f4980.jpg"
                                    alt="Booth pameran Cahaya Selatan Kreasindo"
                                    loading="eager"
                                    class="h-full w-full object-cover object-bottom"
                              />
                        </div>
                  </figure>
            </div>
      </section>

<Section eyebrow="Layanan" title="Solusi display yang tepat untuk bisnis Anda"
         lead="Enam lini pekerjaan, dari POSM dan rak display sampai booth pameran dan signage toko.">
  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {serviceDetails.map((s) => (
      <a href={`/layanan/${s.slug}`}
         class="group overflow-hidden rounded-2xl border border-brand-100 bg-white transition-shadow hover:shadow-md">
        <div class="aspect-4/3 overflow-hidden bg-brand-50">
          <AssetImage
            src={s.assetImage}
            alt={s.title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="p-7">
          <h3 class="text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.lead}</p>
          <span class="mt-3 inline-block text-sm font-medium text-brand-700 group-hover:text-brand-800">
            Selengkapnya &rarr;
          </span>
        </div>
      </a>
    ))}
  </div>
  <a href="/layanan" class="mt-8 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
    Detail layanan &amp; daftar produk &rarr;
  </a>
</Section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <section class="border-y border-brand-100 bg-brand-50/40">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-3">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      {[
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ['Presisi & Kokoh', 'Pengerjaan rapi, material tahan lama, finishing bersih.'],
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      ['Satu Pintu', 'Desain, produksi, kirim, sampai instalasi ditangani satu tim.'],
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ['Tepat Waktu', 'Jadwal event tidak menunggu — kami kerja sesuai deadline.'],
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ].map(([t, d]) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <h2 class="text-base font-semibold">{t}</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <p class="mt-2 text-sm leading-relaxed text-slate-600">{d}</p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Section eyebrow="Portofolio" title="Sebagian pekerjaan kami"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 lead="Booth pameran, rak display ritel, neon box, dan signage untuk berbagai brand.">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           {featuredPortfolio.map((p) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   <figure class="group overflow-hidden rounded-2xl border border-brand-100">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             <div class="aspect-4/3 overflow-hidden bg-brand-50">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         <AssetImage src={p.src} alt={p.title}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              class="h-full w-full cursor-zoom-in object-cover transition-transform duration-500 group-hover:scale-105" />
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </figure>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <a href="/portofolio" class="mt-8 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              Lihat semua portofolio →
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </Section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <section class="border-y border-brand-100 bg-brand-50/40">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <div class="mx-auto max-w-6xl px-5 py-16">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Area layanan</h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <p class="mt-3 max-w-2xl text-slate-600">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              Berbasis di Serpong, melayani Jabodetabek. Survei lokasi dan pemasangan dilakukan tim sendiri.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <ul class="mt-6 flex flex-wrap gap-2">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  {areas.map((a) => (
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <li class="rounded-full border border-brand-200 bg-white px-4 py-1.5 text-sm text-brand-700">{a.name}</li>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ))}
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </ul>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <a href="/area-layanan" class="mt-6 inline-block text-sm font-medium text-brand-700 hover:text-brand-800">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        Detail area layanan →
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              </a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </section>

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <Section class="text-center">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Punya rencana event atau mau renovasi display toko?
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </h2>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        <p class="mx-auto mt-4 max-w-xl text-slate-600">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              Kirim ukuran, foto lokasi, atau referensi desain — kami bantu hitung estimasinya.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  </p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      <a href={waLink()} target="_blank" rel="noopener"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-600">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   <WaIcon />Chat WhatsApp
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       </a>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         </Section>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           <Lightbox />
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           </Base>
