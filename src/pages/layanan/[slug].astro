---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import Lightbox from '../../components/Lightbox.astro';
import WaIcon from '../../components/WaIcon.astro';
import { serviceDetails, portfolio, waLink, site } from '../../site.js';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return serviceDetails.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s }: { s: (typeof serviceDetails)[number] } = Astro.props;
const crumbs = [
  { href: '/layanan/', label: 'Layanan' },
  { href: `/layanan/${s.slug}/`, label: s.nav },
];
const samples = (s.images ?? [])
  .map((img) => portfolio.find((p) => p.img === img))
  .filter((p): p is (typeof portfolio)[number] => Boolean(p));
const others = serviceDetails.filter((o) => o.slug !== s.slug);
const guides = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.data.relatedService === `/layanan/${s.slug}/`)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.description,
  provider: { '@type': 'LocalBusiness', '@id': new URL('/#business', Astro.site).href },
  areaServed: s.areas.map((a) => a.name),
  url: new URL(`/layanan/${s.slug}/`, Astro.site).href,
  image: new URL(s.assetImage, Astro.site).href,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.items.title,
    itemListElement: s.items.groups
      .filter((g) => s.slug !== 'peralatan-event' || g.name === 'Produk')
      .flatMap((g) =>
        g.list.map((x) => ({
          '@type': 'Offer',
          itemOffered: s.slug === 'peralatan-event'
            ? { '@type': 'Product', name: x }
            : { '@type': 'Service', name: x, serviceType: g.name },
        })),
      ),
  },
};
---
<Base waMessage={s.waMsg} title={s.metaTitle} description={s.description} breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 h-[30rem] w-[30rem] rotate-45 border border-csk-amber/15"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:py-20 lg:gap-16 lg:px-8 lg:py-24">
      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-csk-amber">Layanan Produksi <span class="px-2 text-white/40">/</span> {s.nav}</p>
        <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">{s.title}</h1>
        <p class="mt-6 max-w-xl text-sm leading-7 text-white/75 sm:text-base">{s.lead}</p>
        <div class="mt-5 max-w-xl space-y-3 text-sm leading-7 text-white/60">
          {s.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a href={waLink(s.waMsg)} data-cta-location="service_top" target="_blank" rel="noopener"
           class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
          <WaIcon />Minta Penawaran
        </a>
      </div>
      <figure class="relative ml-4 overflow-hidden border border-white/10 bg-white/5 sm:ml-8">
        <div class="aspect-[5/4]">
          <Picture
            name={s.images[0]}
            alt={s.heroAlt ?? s.title}
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 768px) 52vw, 100vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-csk-black/75 via-transparent to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-csk-amber">Cahaya Selatan Kreasindo</p>
          <p class="mt-2 text-lg font-bold text-white sm:text-2xl">{s.nav}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  {s.scope?.length > 0 && (
    <Section eyebrow="Cakupan Layanan" title="Apa yang termasuk dalam layanan ini?">
      <div class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {s.scope.map((item) => (
          <div class="border-t border-csk-gray/20 pt-4">
            <span class="mb-4 block h-1 w-8 bg-csk-amber"></span>
            <p class="text-sm leading-relaxed text-csk-gray">{item}</p>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- Show genuine installed retail displays before specifications; avoid workshop and close-up-only shots. -->
  {s.slug === 'visual-merchandising' && (
    <Section class="pt-0 md:pt-0">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Contoh branding dan display yang sudah terpasang di toko</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-slate-600">
        Contoh display dan branding yang sudah terpasang di area penjualan, lengkap dengan produk dan konteks toko.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
          <div class="flex h-[360px] items-center justify-center bg-csk-gray/10 md:h-[430px]">
            <Picture name="floor-display-custom-kilau-nipis"
                     alt="Display promosi Kilau Nipis yang terpasang dan terisi produk di area toko retail"
                     sizes="(min-width: 640px) 520px, 90vw"
                     class="h-full w-full object-contain" />
          </div>
          <figcaption class="p-5 text-sm leading-relaxed text-csk-gray"><strong class="text-csk-black">Kilau Nipis</strong> — display promosi dengan produk di area penjualan.</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
          <div class="flex h-[360px] items-center justify-center bg-csk-gray/10 md:h-[430px]">
            <Picture name="retail-display-hanasui-installed"
                     alt="Display promosi Hanasui di area kosmetik toko, menampilkan branding dan produk pada rak retail"
                     sizes="(min-width: 640px) 520px, 90vw"
                     class="h-full w-full object-contain" />
          </div>
          <figcaption class="p-5 text-sm leading-relaxed text-csk-gray"><strong class="text-csk-black">Hanasui</strong> — display produk dan materi promosi di area kosmetik retail.</figcaption>
        </figure>
      </div>
    </Section>
  )}

  <!-- Showcase real exhibition projects early for visitors coming from Search Ads. -->
  {s.slug === 'booth-pameran' && samples.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Hasil booth pameran yang sudah kami produksi</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox aria-label={`Galeri ${s.nav}`}>
        {samples.map((p) => (
          <figure class="group overflow-hidden rounded-2xl border border-csk-gray/20">
            <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
              <button
                type="button"
                data-lightbox-trigger
                aria-label={`Buka foto: ${p.title}`}
                class="block h-full w-full focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-csk-amber"
              >
                <Picture name={p.img} alt={p.title}
                         sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                         class="h-full w-full cursor-zoom-in object-contain transition-transform duration-500 group-hover:scale-105" />
              </button>
            </div>
            <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/portofolio/" class="mt-8 inline-block text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
        Lihat semua portofolio →
      </a>
    </Section>
  )}

  {s.visuals?.length > 0 && (
    <Section>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-csk-amber-text">Galeri Jenis Produk</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">{s.visualsTitle ?? 'Contoh visual produk'}</h2>
      {s.visualsIntro && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{s.visualsIntro}</p>}
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {s.visuals.map((v) => (
          <figure class="overflow-hidden rounded-xl border border-csk-gray/20 bg-white">
            <div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-csk-gray/10">
              {v.imageSrc ? (
                <img src={v.imageSrc} alt={v.alt} loading="lazy" decoding="async" class="h-full w-full object-contain" />
              ) : (
                <Picture name={v.image} alt={v.alt} sizes="(min-width: 1280px) 280px, (min-width: 640px) 45vw, 90vw" class="h-full w-full object-contain" />
              )}
            </div>
            <figcaption class="p-4">
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-csk-amber-text">{v.type}</p>
              <h3 class="mt-2 text-sm font-semibold leading-snug text-csk-black">{v.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">{v.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Section>
  )}

  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{s.items.title}</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.items.groups.map((g) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">{g.name}</h3>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {g.list.map((it) => (
                <li class="flex gap-2"><span class="text-csk-amber">—</span>{it}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-csk-gray/20">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Spesifikasi &amp; Material</h2>
      <p class="mt-3 max-w-3xl text-slate-600">
        Kapabilitas produksi di workshop Serpong: material, metode fabrikasi, dan kapasitas pengerjaan untuk booth, display, signage, dan POSM.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Material tersedia</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Akrilik (bening, warna, susu)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Plat besi &amp; metal cutting</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>ACP (Aluminum Composite Panel)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>MDF / HMR</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Plywood / kayu lapis</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>LED &amp; sistem kelistrikan</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Large format printing (stiker, vinyl, banner)</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Metode fabrikasi</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Pemotongan presisi (laser / CNC)</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Pengelasan rangka</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Finishing cat &amp; stiker</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Instalasi LED</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Sistem knock-down untuk event</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-csk-amber">Kapasitas &amp; lead time</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Workshop mandiri di Serpong, Tangerang Selatan</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Melayani seluruh area Jabodetabek</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Lead time 7–14 hari kerja untuk produksi standar</li>
            <li class="flex gap-2"><span class="text-csk-amber">—</span>Kapasitas 50+ unit per bulan</li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  {s.slug !== 'booth-pameran' && s.slug !== 'visual-merchandising' && samples.length > 0 && (
    <Section>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{s.samplesTitle ?? "Contoh pengerjaan"}</h2>
      {s.sampleNote && <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">{s.sampleNote}</p>}
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox aria-label={`Galeri ${s.nav}`}>
        {samples.map((p) => (
          <figure class="group overflow-hidden rounded-2xl border border-csk-gray/20">
            <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
              <Picture name={p.img} alt={p.title}
                       sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                       class="h-full w-full cursor-zoom-in object-contain transition-transform duration-500 group-hover:scale-105" />
            </div>
            <figcaption class="px-5 py-4 text-sm font-medium">{p.title}</figcaption>
          </figure>
        ))}
      </div>
      <a href="/portofolio/" class="mt-8 inline-block text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
        Lihat semua portofolio →
      </a>
    </Section>
  )}

  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Pertanyaan yang sering masuk</h2>
      <dl class="mt-8 space-y-6">
        {s.faq.map((f) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <dt class="font-semibold text-slate-900">{f.q}</dt>
            <dd class="mt-2 leading-relaxed text-slate-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {s.areas?.length > 0 && (
  <section class="border-y border-csk-gray/20 bg-csk-gray/10">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Area layanan {s.title} di Jabodetabek</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {s.areas.map((a) => (
          <div class="rounded-2xl border border-csk-gray/20 bg-white p-6">
            <h3 class="font-semibold">{a.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{a.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  {s.proof?.stat && (
  <Section>
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Kenapa pilih CSK untuk {s.title}</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-slate-600"><strong class="text-2xl font-bold text-csk-black">{s.proof.stat}</strong> — {s.proof.text}</p>
  </Section>
  )}

  {guides.length > 0 && (
    <Section class="border-t border-csk-gray/15">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-amber-text">Panduan terkait</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">Bacaan sebelum memesan {s.nav}</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        {guides.map((article) => (
          <a href={`/blog/${article.id}/`}
             class="group rounded-2xl border border-csk-gray/20 bg-white p-6 hover:border-csk-amber">
            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-csk-amber-text">{article.data.category || 'Panduan'}</span>
            <h3 class="mt-2 text-lg font-semibold tracking-tight text-csk-black group-hover:text-csk-amber-text">{article.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{article.data.description}</p>
            <span class="mt-4 inline-block text-sm font-medium text-csk-amber-text">Baca panduan &rarr;</span>
          </a>
        ))}
      </div>
    </Section>
  )}

  <Section>
    <h2 class="text-2xl font-semibold tracking-tight">Layanan lainnya</h2>
    <div class="mt-6 flex flex-wrap gap-2">
      {others.map((o) => (
        <a href={`/layanan/${o.slug}/`}
            class="rounded-full border border-csk-gray/30 px-4 py-1.5 text-sm text-csk-amber-text transition-colors hover:bg-csk-gray/10">
          {o.nav}
        </a>
      ))}
    </div>
  </Section>

  <Section class="border-t border-csk-gray/15">
    <h2 class="text-2xl font-semibold tracking-tight">Minta penawaran {s.nav}</h2>
    <p class="mt-3 text-csk-gray">Kirim kebutuhan, ukuran, jumlah unit, lokasi, dan target waktu untuk membahas estimasi produksi.</p>
    <a href={waLink(s.waMsg)} data-cta-location="service_end" target="_blank" rel="noopener"
       class="mt-6 inline-flex items-center gap-2 rounded-full bg-csk-amber px-6 py-3 text-sm font-medium text-csk-black hover:bg-csk-amber/90">
      <WaIcon />Minta Penawaran
    </a>
  </Section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Lightbox />
</Base>
