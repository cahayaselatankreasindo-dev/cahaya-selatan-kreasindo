---
const { eyebrow, title, lead, as = 'h2', class: klass = '' } = Astro.props;
const Title = as;
---
<section class:list={['mx-auto max-w-6xl px-5 py-16 md:py-20', klass]}>
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.18em] text-csk-gray">{eyebrow}</p>}
  {title && (
    <Title class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-csk-black md:text-4xl">{title}</Title>
  )}
  {lead && <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">{lead}</p>}
  <slot />
</section>
