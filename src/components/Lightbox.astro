---
// Native <dialog> lightbox. Any figure inside a [data-lightbox] container
// opens on click; Escape and backdrop click close it.
---
<dialog id="lightbox" class="max-h-[92vh] max-w-[92vw] rounded-2xl bg-transparent p-0 backdrop:bg-ink/80">
  <figure class="relative m-0">
    <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-[92vw] rounded-2xl object-contain" />
    <figcaption id="lightbox-cap" class="mt-3 text-center text-sm text-white"></figcaption>
    <button type="button" aria-label="Tutup"
            class="absolute right-3 top-3 rounded-full bg-white/90 px-3 py-1.5 text-sm font-medium text-ink hover:bg-white">
      ✕
    </button>
  </figure>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const cap = document.getElementById('lightbox-cap');
  if (dlg && img && cap) {
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const source = target.closest('[data-lightbox] figure img') as HTMLImageElement | null;
      if (source) {
        img.src = source.currentSrc || source.src;
        img.srcset = source.srcset;
        img.sizes = '92vw';
        img.alt = source.alt;
        cap.textContent = source.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
        dlg.showModal();
        return;
      }
      // backdrop or close button
      if (dlg.open && (target === dlg || target.closest('#lightbox button'))) dlg.close();
    });
  }
</script>
