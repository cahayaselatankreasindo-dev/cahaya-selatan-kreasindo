---
import { site, waLink } from '../site.js';
import WaIcon from './WaIcon.astro';

const icon = 'h-4 w-4 shrink-0 text-white/45';
---

<footer class="mt-0 border-t border-white/10 bg-csk-black text-csk-white">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-6 md:grid-cols-[1.15fr_1fr_1fr] md:gap-10 lg:px-8 lg:py-20">
    <div>
      <p class="text-lg font-bold tracking-tight text-white">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-7 text-white/60">{site.tagline}</p>
      <a href={waLink()} target="_blank" rel="noopener"
         data-cta-location="footer"
         class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-sm bg-csk-amber px-5 py-2.5 text-xs font-bold uppercase tracking-[0.08em] text-csk-black transition-colors hover:brightness-95">
        <WaIcon />
        Konsultasikan Kebutuhan
      </a>
    </div>

    <div class="text-sm">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-white">Kontak</p>
      <ul class="mt-5 space-y-4 text-white/65">
        <li>
          <a class="inline-flex items-center gap-3 transition-colors hover:text-csk-amber" href="https://www.tiktok.com/@cahayaselatankreasindo" target="_blank" rel="noopener">
            <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.66a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.09z"/>
            </svg>
            @cahayaselatankreasindo
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-3 transition-colors hover:text-csk-amber" href={`mailto:${site.email}`}>
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            {site.email}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-3 transition-colors hover:text-csk-amber" href={`https://www.instagram.com/${site.ig}`} target="_blank" rel="noopener">
            <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @{site.ig}
          </a>
        </li>
        <li>
          <a class="inline-flex items-center gap-3 transition-colors hover:text-csk-amber" href={`https://www.threads.com/@${site.ig}`} target="_blank" rel="noopener">
            <svg class={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.9 11.13c-.1-.05-.2-.09-.3-.13-.18-3.23-1.94-5.08-4.9-5.1h-.04c-1.77 0-3.24.75-4.15 2.13l1.63 1.12c.68-1.03 1.74-1.25 2.52-1.25h.03c.97 0 1.7.29 2.17.84.35.4.58.96.69 1.67a12.6 12.6 0 0 0-2.79-.13c-2.81.16-4.61 1.79-4.49 4.06.06 1.15.64 2.14 1.62 2.79.83.54 1.9.81 3.01.75 1.47-.08 2.62-.64 3.42-1.66.61-.77.99-1.77 1.16-3.03.7.42 1.21.97 1.5 1.64.48 1.14.51 3-1.01 4.52-1.33 1.33-2.93 1.9-5.35 1.92-2.69-.02-4.72-.88-6.04-2.56C4.34 16.9 3.7 14.66 3.68 12c.02-2.67.66-4.9 1.9-6.63 1.32-1.68 3.35-2.54 6.04-2.56 2.7.02 4.77.88 6.14 2.57.68.83 1.19 1.87 1.53 3.09l1.91-.51c-.41-1.5-1.06-2.8-1.94-3.87C17.5 1.98 14.93.87 11.63.85h-.01C8.32.87 5.78 1.99 4.08 4.18 2.57 6.13 1.79 8.84 1.76 12v.01c.03 3.15.81 5.86 2.32 8.06 1.7 2.18 4.24 3.3 7.54 3.32h.01c2.94-.02 5.01-.79 6.72-2.5 2.24-2.23 2.17-5.03 1.43-6.75-.53-1.23-1.54-2.23-2.92-2.9zm-4.96 4.98c-1.23.07-2.5-.48-2.57-1.63-.05-.85.6-1.8 2.65-1.92.24-.01.47-.02.7-.02.74 0 1.44.07 2.07.21-.24 2.94-1.62 3.3-2.85 3.36z"/>
            </svg>
            @{site.ig}
          </a>
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-white">Workshop</p>
      <div class="mt-5 flex items-start gap-3 text-white/65">
        <svg class={`${icon} mt-0.5`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <address class="not-italic leading-relaxed">
          {site.street}<br />{site.city}, {site.region} {site.postalCode}
        </address>
      </div>
      <p class="mt-4 flex items-start gap-3 text-white/65">
        <svg class={`${icon} mt-0.5`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
        <span>
          {site.hours.map((h) => <span class="block">{h.days} {h.time}</span>)}
        </span>
      </p>
      <a href="/area-layanan/" class="mt-4 inline-block text-xs font-bold uppercase tracking-[0.1em] text-csk-amber transition-colors hover:text-white">Area layanan →</a>
    </div>
  </div>

  <div class="border-t border-white/10 px-5 py-6 text-center text-xs text-white/45">
    <p class="mb-3 flex flex-wrap justify-center gap-x-5 gap-y-2">
      <a href="/kontak/" class="transition-colors hover:text-csk-amber">Kontak &amp; alamat workshop</a>
      <a href="/blog/" class="transition-colors hover:text-csk-amber">Blog &amp; Panduan</a>
      <a href="/apa-itu-posm/" class="transition-colors hover:text-csk-amber">Apa itu POSM</a>
      <a href="/kebijakan-privasi/" class="transition-colors hover:text-csk-amber">Kebijakan Privasi</a>
      <a href="/syarat-ketentuan/" class="transition-colors hover:text-csk-amber">Syarat &amp; Ketentuan</a>
    </p>
    © {new Date().getFullYear()} {site.name} — {site.tagline}.
  </div>
</footer>
