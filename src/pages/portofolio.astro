---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { portfolio, portfolioCats, waLink } from '../site.js';

const slug = (c) => c.replace(/[^a-zA-Z]+/g, '-').toLowerCase();
const catLink = {
  'Booth & Pameran': '/layanan/booth-pameran/',
  'Rak Display': '/layanan/rak-display-gondola/',
  'POSM': '/layanan/posm-display/',
  'Neon Box & Signage': '/layanan/neon-box-signage/',
  'Proses Produksi': '/tentang/',
};
// Guides support the corresponding service. They do not replace commercial service pages.
const catGuide = {
  'Booth & Pameran': '/blog/checklist-brief-booth-pameran-custom/',
  'Rak Display': '/blog/memilih-rak-display-custom-gondola-toko/',
  'POSM': '/blog/floor-display-vs-counter-display-posm/',
  'Neon Box & Signage': '/blog/panduan-neon-box-vs-huruf-timbul/',
};
import WaIcon from '../components/WaIcon.astro';
import Lightbox from '../components/Lightbox.astro';
---
<Base
  title="Portofolio Booth Pameran & Rak Display"
  description="Dokumentasi pekerjaan Cahaya Selatan Kreasindo: booth pameran, gondola supermarket, rak display ritel, neon box, dan signage toko di Jabodetabek."
  image="/og-image.webp"
  breadcrumbs={[{ href: '/portofolio', label: 'Portofolio' }]}
>
  <Breadcrumbs items={[{ href: '/portofolio', label: 'Portofolio' }]} />

  <Section
    as="h1"
    eyebrow="Portofolio"
    title="Pekerjaan yang sudah kami kerjakan"
    lead="Booth pameran, rak display ritel, neon box, sampai signage toko — dikerjakan sendiri oleh tim kami dari desain hingga pemasangan."
  >
    <div class="mt-8 flex flex-wrap gap-2">
      {portfolioCats.map((c) => (
        <a href={`#${slug(c)}`}
            class="rounded-full border border-csk-gray/30 px-4 py-1.5 text-sm text-csk-amber-text transition-colors hover:bg-csk-gray/10">
          {c}
        </a>
      ))}
    </div>
  </Section>

  {portfolioCats.map((cat) => (
    <section id={slug(cat)} class="mx-auto max-w-6xl scroll-mt-24 px-5 pb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-2xl font-semibold tracking-tight">{cat}</h2>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <a href={catLink[cat]} class="text-sm font-medium text-csk-amber-text hover:text-csk-amber-text/80">
            {cat === 'Proses Produksi' ? 'Cara kerja kami →' : `Layanan ${cat.toLowerCase()} →`}
          </a>
          {catGuide[cat] && (
            <a href={catGuide[cat]} class="text-sm font-medium text-csk-gray underline-offset-4 hover:text-csk-amber-text hover:underline">
              Panduan terkait →
            </a>
          )}
        </div>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-lightbox>
        {portfolio.filter((p) => p.cat === cat).map((p) => (
          <figure id={`proyek-${p.img}`} data-portfolio-reveal class="group scroll-mt-28 overflow-hidden rounded-2xl border border-csk-gray/20 bg-white">
            <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
              <Picture
                name={p.img}
                alt={p.title}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                class="h-full w-full cursor-zoom-in object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <figcaption class="px-5 py-4">
              <p class="text-sm font-medium">{p.title}</p>
              <p class="mt-0.5 text-xs text-slate-600">{p.cat}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}

  <Section class="text-center">
    <h2 class="text-3xl font-semibold tracking-tight">Mau hasil serupa untuk brand Anda?</h2>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">
      Kirim referensi atau foto lokasi, kami bantu susun konsep dan estimasi biayanya.
    </p>
    <a href={waLink('Halo, saya lihat portofolio di website. Saya ingin konsultasi untuk kebutuhan berikut:')}
       target="_blank" rel="noopener"
       class="mt-8 inline-flex items-center gap-2 rounded-full bg-csk-amber px-7 py-3 text-sm font-medium text-csk-black transition-colors hover:bg-csk-amber/90">
      <WaIcon />Konsultasi Sekarang
    </a>
  </Section>
  <Lightbox />
  <style>
    [data-portfolio-reveal] {
      transition: opacity 550ms ease, transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-portfolio-reveal][data-reveal-pending] {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    @media (prefers-reduced-motion: reduce) {
      [data-portfolio-reveal] {
        transition: none;
        transform: none;
      }
    }
  </style>

  <script>
    const revealCards = Array.from(document.querySelectorAll<HTMLElement>('[data-portfolio-reveal]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Keep above-the-fold cards visible so this animation never delays first paint.
    if ('IntersectionObserver' in window && !reducedMotion.matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.removeAttribute('data-reveal-pending');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.05, rootMargin: '0px 0px -24px 0px' });

      for (const card of revealCards) {
        if (card.getBoundingClientRect().top > window.innerHeight) {
          card.setAttribute('data-reveal-pending', '');
          observer.observe(card);
        }
      }

      // If a visitor enables reduced motion mid-session, reveal everything.
      reducedMotion.addEventListener('change', () => {
        if (!reducedMotion.matches) return;
        observer.disconnect();
        for (const card of revealCards) card.removeAttribute('data-reveal-pending');
      });
    }
  </script>
</Base>
