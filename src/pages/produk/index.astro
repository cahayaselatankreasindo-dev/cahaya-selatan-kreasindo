---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import { productDetails, waLink } from '../../site.js';
const categories = [...new Set(productDetails.map((p) => p.category))];
---
<Base title="Katalog POSM, Product Glorifier & Acrylic Display Custom" description="Lihat pilihan POSM, floor display, counter display, product glorifier, acrylic showcase, pedestal, dan aksesori retail custom dari Cahaya Selatan Kreasindo untuk kebutuhan brand dan toko." breadcrumbs={[{href:'/produk/',label:'Katalog Produk'}]}>
  <Breadcrumbs items={[{href:'/produk/',label:'Katalog Produk'}]} />
  <section class="bg-csk-black text-white"><div class="mx-auto max-w-7xl px-5 py-16 md:py-20"><p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">Katalog Produk CSK</p><h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">Temukan format display yang sesuai kebutuhan brand.</h1><p class="mt-5 max-w-2xl text-sm leading-7 text-white/65 sm:text-base">Jelajahi jenis POSM, product glorifier, dan acrylic display. Setiap produk dapat dibahas dari sisi fungsi, ukuran, material, finishing, jumlah, serta lokasi penempatan.</p><a href={waLink('Halo CSK, saya ingin konsultasi katalog produk custom.')} target="_blank" rel="noopener" data-cta-location="product_catalog_hero" class="mt-8 inline-flex min-h-12 items-center rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black">Konsultasi kebutuhan</a></div></section>
  <nav aria-label="Kategori katalog produk" class="mx-auto flex max-w-7xl flex-wrap gap-2 px-5 py-8">{categories.map((category,index) => <a href={`#kategori-${index}`} class="rounded-full border border-csk-gray/30 px-4 py-2 text-xs font-semibold text-csk-amber-text hover:border-csk-amber">{category}</a>)}</nav>
  {categories.map((category,index) => <section id={`kategori-${index}`} class="mx-auto max-w-7xl scroll-mt-24 px-5 pb-14"><div class="mb-7 flex flex-wrap items-end justify-between gap-4 border-b border-csk-gray/20 pb-4"><div><p class="text-xs font-bold uppercase tracking-[0.16em] text-csk-amber-text">Kategori Produk</p><h2 class="mt-2 text-2xl font-bold tracking-tight text-csk-black">{category}</h2></div><div class="flex flex-wrap items-center gap-4"><span class="text-xs text-csk-gray">{productDetails.filter((p)=>p.category===category).length} jenis</span><a href={waLink(`Halo CSK, saya ingin konsultasi kategori ${category}. Mohon bantu rekomendasikan produk dan spesifikasi yang sesuai.`)} target="_blank" rel="noopener" data-cta-location="product_category" class="inline-flex min-h-10 items-center text-xs font-bold text-csk-amber-text underline underline-offset-4 hover:text-csk-black">Konsultasikan kategori →</a></div></div><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">{productDetails.filter((p)=>p.category===category).map((p)=><a href={`/produk/${p.slug}/`} class="group overflow-hidden rounded-xl border border-csk-gray/20 bg-white transition-colors hover:border-csk-amber"><div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-csk-gray/10">{p.imageSrc ? <img src={p.imageSrc} alt={p.imageAlt} loading="lazy" decoding="async" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]" /> : <Picture name={p.image} alt={p.imageAlt} sizes="(min-width: 1280px) 280px, (min-width: 640px) 45vw, 90vw" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]" />}</div><div class="p-5"><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-csk-amber-text">{p.visualType}</p><h3 class="mt-2 text-base font-bold leading-snug text-csk-black group-hover:text-csk-amber-text">{p.title}</h3><p class="mt-2 text-sm leading-relaxed text-csk-gray">{p.short}</p><span class="mt-4 inline-flex text-xs font-bold text-csk-amber-text">Lihat detail produk ↗</span></div></a>)}</div></section>)}
</Base>