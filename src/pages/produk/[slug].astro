---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import WaIcon from '../../components/WaIcon.astro';
import { productDetails, serviceDetails, portfolio, waLink } from '../../site.js';
export function getStaticPaths() {
  return productDetails.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const service = serviceDetails.find((s) => s.slug === p.serviceSlug);
const relatedPortfolio = p.image ? portfolio.filter((item) => item.img === p.image) : [];
const crumbs = [{ href: '/produk/', label: 'Katalog Produk' }, { href: `/produk/${p.slug}/`, label: p.title }];
const quoteMessage = `Halo CSK, saya ingin konsultasi ${p.title}.\\n\\nNama perusahaan/brand: \\nUkuran: \\nJumlah unit: \\nMaterial: \\nLokasi: \\nTarget waktu: `;
const schema = { '@context':'https://schema.org', '@type':'Service', name:p.title, description:p.description, provider:{'@type':'LocalBusiness','@id':new URL('/#business',Astro.site).href}, areaServed:['Tangerang Selatan','Tangerang','Jakarta','Depok','Bogor','Bekasi'], url:new URL(`/produk/${p.slug}/`,Astro.site).href };
---
<Base title={p.title + ' Custom | CSK'} description={`${p.description} Konsultasi desain, material, finishing, dan produksi custom untuk kebutuhan brand serta retail di Jabodetabek.`} breadcrumbs={crumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Breadcrumbs items={crumbs} />
  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:py-20 lg:gap-16 lg:px-8">
      <div><p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">{p.category}</p><h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">{p.title}</h1><p class="mt-5 max-w-xl text-sm leading-7 text-white/75 sm:text-base">{p.short}</p><p class="mt-4 max-w-xl text-sm leading-7 text-white/60">{p.description}</p><div class="mt-8 flex flex-wrap gap-3"><a href="#penawaran" class="inline-flex min-h-12 items-center rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black">Minta Penawaran</a><a href={waLink(quoteMessage)} target="_blank" rel="noopener" data-cta-location="product_hero" class="inline-flex min-h-12 items-center gap-2 border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:border-csk-amber hover:text-csk-amber"><WaIcon />Chat CSK</a></div></div>
      <figure class="overflow-hidden border border-white/10 bg-white/5"><div class="flex aspect-[5/4] items-center justify-center bg-white/5">{p.imageSrc ? <img src={p.imageSrc} alt={p.imageAlt} loading="eager" decoding="async" class="h-full w-full object-contain" /> : <Picture name={p.image} alt={p.imageAlt} loading="eager" fetchpriority="high" sizes="(min-width: 768px) 52vw, 100vw" class="h-full w-full object-contain" />}</div><figcaption class="border-t border-white/10 px-5 py-3 text-xs text-white/60">{p.visualType} — visual untuk referensi jenis produk.</figcaption></figure>
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-2 md:py-20">
    <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-csk-amber-text">Fungsi Produk</p><h2 class="mt-3 text-2xl font-bold tracking-tight text-csk-black">Untuk apa display ini digunakan?</h2><p class="mt-4 text-sm leading-7 text-csk-gray">{p.function}</p><h3 class="mt-8 text-sm font-bold uppercase tracking-[0.12em] text-csk-black">Cocok untuk</h3><ul class="mt-4 space-y-3 text-sm text-csk-gray">{p.bestFor.map((item) => <li class="flex gap-3"><span class="text-csk-amber">—</span>{item}</li>)}</ul></div>
    <div class="grid gap-5 sm:grid-cols-2"><div class="rounded-xl border border-csk-gray/20 p-5"><h3 class="text-sm font-bold uppercase tracking-[0.12em] text-csk-black">Pilihan material</h3><ul class="mt-4 space-y-2 text-sm leading-relaxed text-csk-gray">{p.materials.map((item) => <li>— {item}</li>)}</ul></div><div class="rounded-xl border border-csk-gray/20 p-5"><h3 class="text-sm font-bold uppercase tracking-[0.12em] text-csk-black">Pilihan finishing</h3><ul class="mt-4 space-y-2 text-sm leading-relaxed text-csk-gray">{p.finishings.map((item) => <li>— {item}</li>)}</ul></div></div>
  </section>
  <section class="border-y border-csk-gray/20 bg-csk-gray/10"><div class="mx-auto max-w-6xl px-5 py-14"><h2 class="text-2xl font-bold tracking-tight text-csk-black">Hal yang perlu disiapkan sebelum produksi</h2><div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{[['Dimensi','Ukuran produk dan ruang penempatan.'],['Beban','Berat produk dan jumlah yang akan dipajang.'],['Jumlah','Kebutuhan unit dan jumlah outlet.'],['Waktu & lokasi','Target selesai, pengiriman, dan instalasi.']].map(([title,text]) => <div class="border-t border-csk-amber pt-4"><h3 class="text-sm font-bold text-csk-black">{title}</h3><p class="mt-2 text-sm leading-relaxed text-csk-gray">{text}</p></div>)}</div><p class="mt-7 max-w-3xl text-xs leading-relaxed text-csk-gray">Daftar material dan finishing merupakan opsi awal pembahasan. Spesifikasi akhir, metode produksi, ketersediaan bahan, serta estimasi biaya ditetapkan setelah kebutuhan dan gambar kerja ditinjau tim CSK.</p></div></section>
  <QuoteForm productName={p.title} productSlug={p.slug} serviceName={service?.nav ?? p.category} />
  <section class="mx-auto flex max-w-6xl flex-col gap-5 px-5 py-12 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.16em] text-csk-amber-text">Kategori Terkait</p><h2 class="mt-2 text-xl font-bold text-csk-black">{service?.nav ?? p.category}</h2>{relatedPortfolio[0] && <a href={`/portofolio/#hasil-${relatedPortfolio[0].img}`} class="mt-3 inline-flex text-sm font-semibold text-csk-amber-text underline underline-offset-4">Lihat dokumentasi terkait: {relatedPortfolio[0].title}</a>}</div><div class="flex flex-wrap gap-3">{service && <a href={`/layanan/${service.slug}/`} class="text-sm font-semibold text-csk-amber-text underline underline-offset-4">Lihat layanan terkait</a>}<a href="/produk/" class="text-sm font-semibold text-csk-amber-text underline underline-offset-4">Kembali ke katalog produk</a></div></section>
</Base>