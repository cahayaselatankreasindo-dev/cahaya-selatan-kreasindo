---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { portfolio, portfolioCats, waLink } from '../site.js';
import WaIcon from '../components/WaIcon.astro';
import Lightbox from '../components/Lightbox.astro';

const slug = (c) => c.replace(/[^a-zA-Z]+/g, '-').toLowerCase();
const catLink = {
  'Booth & Pameran': '/layanan/booth-pameran/',
  'Rak Display': '/layanan/rak-display-gondola/',
  'POSM': '/layanan/posm-display/',
  'Neon Box & Signage': '/layanan/neon-box-signage/',
  'Proses Produksi': '/tentang/',
};
const catGuide = {
  'Booth & Pameran': '/blog/checklist-brief-booth-pameran-custom/',
  'Rak Display': '/blog/memilih-rak-display-custom-gondola-toko/',
  'POSM': '/blog/floor-display-vs-counter-display-posm/',
  'Neon Box & Signage': '/blog/panduan-neon-box-vs-huruf-timbul/',
};
const categoryMessages = {
  'Booth & Pameran': 'Halo CSK, saya melihat portofolio booth dan pameran. Saya ingin konsultasi proyek serupa.',
  'Rak Display': 'Halo CSK, saya melihat portofolio rak display. Saya ingin konsultasi kebutuhan rak atau gondola custom.',
  'POSM': 'Halo CSK, saya melihat portofolio POSM. Saya ingin konsultasi display promosi untuk brand saya.',
  'Neon Box & Signage': 'Halo CSK, saya melihat portofolio signage. Saya ingin konsultasi neon box atau huruf timbul.',
  'Proses Produksi': 'Halo CSK, saya ingin konsultasi proses produksi dan custom fabrication.'
};
---

<Base
  title="Portofolio CSK | Booth, Retail Display & Signage"
  description="Dokumentasi hasil produksi Cahaya Selatan Kreasindo: booth pameran, gondola supermarket, rak display ritel, POSM, neon box, dan signage toko di Jabodetabek."
  image="/og-image.webp"
  breadcrumbs={[{ href: '/portofolio/', label: 'Portofolio' }]}
>
  <Breadcrumbs items={[{ href: '/portofolio/', label: 'Portofolio' }]} />

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 h-[30rem] w-[30rem] rotate-45 border border-csk-amber/15"></div>
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 md:py-20 lg:px-8 lg:py-24">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-csk-amber">Portofolio CSK</p>
      <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Hasil produksi yang hadir di ruang nyata.
      </h1>
      <p class="mt-6 max-w-2xl text-sm leading-7 text-white/70 sm:text-base">
        Dokumentasi pekerjaan CSK untuk kebutuhan retail, signage, booth pameran, dan custom fabrication. Setiap hasil dibuat mengikuti fungsi, ukuran, dan identitas brand.
      </p>
      <div class="mt-9 flex flex-wrap gap-2">
        {portfolioCats.map((c) => (
          <a href={'#' + slug(c)}
             class="inline-flex min-h-11 items-center rounded-sm border border-white/25 px-4 py-2 text-xs font-semibold text-white/80 transition-colors hover:border-csk-amber hover:text-csk-amber focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-csk-amber">
            {c}
          </a>
        ))}
      </div>
    </div>
  </section>

  {portfolioCats.map((cat, catIndex) => {
    const items = portfolio.filter((p) => p.cat === cat);
    const hasFeature = items.length >= 3;

    return (
      <section id={slug(cat)} class="mx-auto max-w-7xl scroll-mt-24 px-5 pb-20" aria-labelledby={'kategori-' + slug(cat)}>
        <div class="flex flex-wrap items-end justify-between gap-5 border-t border-csk-gray/20 pt-8">
          <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.22em] text-csk-amber-text">
              Hasil Produksi
            </p>
            <h2 id={'kategori-' + slug(cat)} class="text-2xl font-bold leading-tight tracking-tight text-csk-black sm:text-3xl">{cat}</h2>
          </div>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href={catLink[cat]} class="inline-flex min-h-11 items-center text-sm font-semibold text-csk-amber-text underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
              {cat === 'Proses Produksi' ? 'Lihat proses kerja →' : 'Lihat layanan terkait →'}
            </a>
            {catGuide[cat] && (
              <a href={catGuide[cat]} class="inline-flex min-h-11 items-center text-sm font-medium text-csk-gray underline-offset-4 hover:text-csk-amber-text hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
                Panduan terkait →
              </a>
            )}
            <a href={waLink(categoryMessages[cat] ?? 'Halo CSK, saya ingin konsultasi kebutuhan produksi.')}
               target="_blank" rel="noopener" data-cta-location="portfolio_category"
               class="inline-flex min-h-11 items-center text-sm font-semibold text-csk-amber-text underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
              Diskusikan proyek serupa →
            </a>
          </div>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:auto-rows-[235px] lg:grid-cols-3 lg:grid-flow-row-dense lg:gap-4" data-lightbox>
          {items.map((p, index) => (
            <figure
              id={'hasil-' + p.img}
              data-portfolio-reveal
              class:list={[
                'group relative isolate min-h-[280px] scroll-mt-28 overflow-hidden rounded-xl bg-csk-black sm:min-h-[300px] lg:min-h-0',
                hasFeature && index === 0 ? 'sm:col-span-2 lg:col-span-2 lg:row-span-2' : '',
              ]}
            >
              <button
                type="button"
                data-lightbox-trigger
                aria-label={`Buka foto: ${p.title}`}
                class="absolute inset-0 block h-full w-full cursor-zoom-in text-left focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-csk-amber"
              >
                <Picture
                  name={p.img}
                  alt={p.title}
                  sizes={hasFeature && index === 0
                    ? '(min-width: 1024px) 740px, (min-width: 640px) 90vw, 95vw'
                    : '(min-width: 1024px) 360px, (min-width: 640px) 45vw, 95vw'}
                  loading={catIndex === 0 && index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={catIndex === 0 && index === 0 ? 'high' : undefined}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.035]"
                />
              </button>
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-csk-black/90 via-csk-black/25 to-transparent"></div>
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 p-5 text-white sm:p-6 lg:p-7">
                <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/80">{cat}</p>
                <h3 class:list={[
                  'max-w-2xl font-semibold leading-snug text-white',
                  hasFeature && index === 0 ? 'text-xl sm:text-2xl lg:text-3xl' : 'text-base sm:text-lg',
                ]}>
                  {p.title}
                </h3>
                {p.img === 'booth-512-slow-move-bazaar' && (
                  <a href="/portofolio/booth-512-slow-move-bazaar/"
                     class="pointer-events-auto mt-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-csk-amber transition-colors hover:text-white">
                    Buka studi kasus <span aria-hidden="true">→</span>
                  </a>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    );
  })}

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rotate-45 border border-csk-amber/20"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-16 text-center md:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">Konsultasi Produksi</p>
      <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
        Ada kebutuhan produksi untuk brand Anda?
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-white/65 sm:text-base">
        Kirimkan referensi atau foto lokasi. Kami bantu membahas solusi produksi dan estimasi pengerjaan yang sesuai kebutuhan.
      </p>
      <a href={waLink('Halo CSK, saya melihat hasil produksi di portofolio dan ingin konsultasi kebutuhan berikut:')}
         target="_blank" rel="noopener"
         data-cta-location="portfolio_final_cta"
         class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-7 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95">
        <WaIcon />Konsultasikan Kebutuhan
      </a>
    </div>
  </section>
  <Lightbox />
  <style>
    [data-portfolio-reveal] {
      transition: opacity 550ms ease, transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    @media (hover: hover) and (pointer: fine) {
      [data-portfolio-reveal]:hover { box-shadow: 0 18px 36px -24px rgba(11, 11, 11, 0.3); }
    }
    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      [data-portfolio-reveal]:not([data-reveal-pending]):hover { transform: translate3d(0, -4px, 0); }
    }
    [data-portfolio-reveal][data-reveal-pending] { opacity: 0; transform: translate3d(0, 20px, 0); }
    @media (prefers-reduced-motion: reduce) {
      [data-portfolio-reveal] { transition: none; transform: none; }
    }
  </style>
  <script>
    const revealCards = Array.from(document.querySelectorAll<HTMLElement>('[data-portfolio-reveal]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if ('IntersectionObserver' in window && !reducedMotion.matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.removeAttribute('data-reveal-pending');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.05, rootMargin: '0px 0px -24px 0px' });
      for (const card of revealCards) {
        if (card.getBoundingClientRect().top > window.innerHeight) {
          card.setAttribute('data-reveal-pending', '');
          observer.observe(card);
        }
      }
      reducedMotion.addEventListener('change', () => {
        if (!reducedMotion.matches) return;
        observer.disconnect();
        for (const card of revealCards) card.removeAttribute('data-reveal-pending');
      });
    }
  </script>
</Base>
