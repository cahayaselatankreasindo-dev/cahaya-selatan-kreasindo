---
import { render } from 'astro:content';
import Base from './Base.astro';

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = entry.data;
const slug = entry.id;

const faq = fm.faq ?? [];

const faqSchema = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: fm.title,
  description: fm.description,
  datePublished: fm.pubDate.toISOString(),
  author: { '@type': 'Person', name: fm.author },
  image: fm.image,
  publisher: { '@type': 'Organization', name: 'Cahaya Selatan Kreasindo' },
};

const crumbs = [
  { href: '/', label: 'Beranda' },
  { href: '/blog', label: 'Blog' },
  { href: `/blog/${slug}`, label: fm.title },
];
---
<Base title={fm.title} description={fm.description} image={fm.image} breadcrumbs={crumbs}>
  <article class="mx-auto w-full max-w-[42rem] px-4 py-12 md:px-6 md:py-16 bg-csk-white">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-csk-amber-text">Blog</p>
    <h1 class="mt-3 text-3xl font-bold leading-tight text-csk-black md:text-4xl">{fm.title}</h1>
    <p class="mt-3 text-sm text-slate-600">
      Oleh {fm.author} · {fm.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })} · ±5 menit baca
    </p>

    <div class="prose prose-lg mt-8 max-w-none
                  prose-headings:text-csk-black prose-headings:font-bold prose-headings:tracking-tight
                  prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-csk-amber/40 prose-h2:pb-2
                  prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:text-csk-gray prose-p:leading-relaxed prose-p:mb-5 prose-p:text-base
                  prose-a:text-csk-amber-text prose-a:font-medium prose-a:underline prose-a:decoration-csk-amber/40 prose-a:underline-offset-4 hover:prose-a:text-csk-amber
                  prose-img:rounded-xl prose-img:my-8 prose-img:shadow-md
                  prose-ul:my-5 prose-ol:my-5 prose-li:my-2
                  prose-strong:text-csk-black prose-strong:font-semibold
                  prose-blockquote:border-l-4 prose-blockquote:border-csk-amber prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-csk-gray
                  prose-hr:my-12 prose-hr:border-csk-gray/20
                  prose-table:my-6 prose-th:py-2 prose-th:px-3 prose-th:border-b-2 prose-th:border-csk-gray/30 prose-th:bg-csk-gray/5 prose-th:font-semibold prose-td:py-2 prose-td:px-3 prose-td:border-b prose-td:border-csk-gray/15">
      <Content />
    </div>

    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </article>
</Base>
