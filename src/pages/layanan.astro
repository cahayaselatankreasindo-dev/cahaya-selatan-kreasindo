---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import WaIcon from '../components/WaIcon.astro';
import { serviceDetails, products, waLink } from '../site.js';

const serviceInquiryMessage = 'Halo CSK, saya ingin konsultasi kebutuhan produksi.\\n\\nNama perusahaan/brand: \\nJenis kebutuhan: \\nUkuran atau jumlah: \\nLokasi: \\nTarget waktu: \\nReferensi/foto: ';
---

<Base
  title="Layanan Produksi CSK | Retail Display, POSM, Booth & Signage"
  description="Layanan Cahaya Selatan Kreasindo: POSM, product glorifier, digital printing, large-format graphics, rak display dan gondola, booth pameran, signage, visual merchandising, serta kebutuhan event. Berbasis di Serpong, melayani Jabodetabek."
  breadcrumbs={[{ href: '/layanan/', label: 'Layanan' }]}
>
  <Breadcrumbs items={[{ href: '/layanan/', label: 'Layanan' }]} />

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 h-[30rem] w-[30rem] rotate-45 border border-csk-amber/15"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-[0.95fr_1.05fr] md:py-20 lg:gap-16 lg:px-8 lg:py-24">
      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-csk-amber">Layanan Produksi CSK</p>
        <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Solusi produksi untuk setiap titik brand.
        </h1>
        <p class="mt-6 max-w-xl text-sm leading-7 text-white/70 sm:text-base">
          Dari area penjualan hingga ruang pameran, kami mengerjakan kebutuhan visual dan fisik brand dengan ukuran, material, serta finishing yang menyesuaikan kebutuhan.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={waLink(serviceInquiryMessage)} target="_blank" rel="noopener"
             data-cta-location="services_hero"
             class="inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
            <WaIcon />Konsultasikan Kebutuhan
          </a>
          <a href="/portofolio/"
             class="inline-flex min-h-12 items-center rounded-sm border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-csk-amber hover:text-csk-amber">
            Lihat Hasil Produksi <span aria-hidden="true" class="ml-2">→</span>
          </a>
        </div>
        <p class="mt-8 text-xs font-medium uppercase tracking-[0.14em] text-white/45">
          Workshop Serpong <span class="px-2 text-csk-amber">/</span> Melayani Jabodetabek
        </p>
      </div>

      <figure class="relative ml-4 overflow-hidden border border-white/10 bg-white/5 sm:ml-8">
        <div class="aspect-[5/4]">
          <Picture
            name="booth-pameran-custom-jakarta-jasa-tirta"
            alt="Booth pameran Jasa Tirta II hasil produksi Cahaya Selatan Kreasindo"
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 768px) 52vw, 100vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-csk-black/75 via-transparent to-transparent"></div>
        <figcaption class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-csk-amber">Booth & Pameran</p>
          <p class="mt-2 max-w-md text-lg font-bold leading-tight text-white sm:text-2xl">Ruang brand yang dirancang untuk hadir di dunia nyata.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 py-16 md:py-20">
      <div class="mb-10 flex flex-col gap-5 md:mb-12 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Yang Kami Kerjakan</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">
            Tujuh lini pekerjaan. Satu partner produksi.
          </h2>
        </div>
        <p class="max-w-lg text-sm leading-relaxed text-csk-gray sm:text-base">
          Pilih layanan yang paling dekat dengan kebutuhan Anda. Setiap pekerjaan dapat disesuaikan dengan ukuran lokasi, karakter produk, dan identitas brand.
        </p>
      </div>

      <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {serviceDetails.map((s) => (
          <a href={'/layanan/' + s.slug + '/'}
             class="group block"
             aria-label={'Lihat detail layanan ' + s.title}>
            <div class="aspect-[5/4] overflow-hidden bg-csk-black">
              <Picture
                name={s.images[0]}
                alt={s.nav}
                sizes="(min-width: 1152px) 368px, (min-width: 640px) 50vw, calc(100vw - 40px)"
                class="h-full w-full object-cover transition-transform duration-700 motion-safe:group-hover:scale-[1.035]"
              />
            </div>
            <div class="border-b border-csk-gray/20 pb-6 pt-5">
              <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-csk-amber-text">{s.cat}</p>
              <div class="mt-2 flex items-start justify-between gap-4">
                <h3 class="text-lg font-bold leading-tight text-csk-black transition-colors group-hover:text-csk-amber-text">{s.nav}</h3>
                <span aria-hidden="true" class="text-xl text-csk-amber transition-transform group-hover:translate-x-1">↗</span>
              </div>
              <p class="mt-3 text-sm leading-6 text-csk-gray">{s.lead}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-csk-black text-white">
    <div class="mx-auto max-w-7xl px-5 py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">Katalog Produk & Referensi Visual</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl">
          Dari display retail sampai perlengkapan event.
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-white/65 sm:text-base">
          Pilih kategori untuk melihat ragam produk yang dapat dikembangkan CSK. Foto merupakan dokumentasi pekerjaan atau referensi visual terdekat dari kategori tersebut; tidak berarti setiap item pada daftar sudah memiliki foto proyek tersendiri.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {products.map((p) => (
          <article class="group overflow-hidden rounded-xl border border-white/15 bg-white/[0.035]">
            <div class="aspect-[16/10] overflow-hidden bg-white/10">
              {p.imageSrc ? (
                <img src={p.imageSrc} alt={p.imageAlt} loading="lazy" decoding="async"
                     class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]" />
              ) : (
                <Picture name={p.image} alt={p.imageAlt}
                         sizes="(min-width: 1280px) 380px, (min-width: 640px) 50vw, 100vw"
                         class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]" />
              )}
            </div>
            <div class="p-5 sm:p-6">
              <h3 class="text-sm font-bold uppercase leading-snug tracking-[0.12em] text-csk-amber">{p.group}</h3>
              <p class="mt-2 text-xs leading-relaxed text-white/55">{p.imageNote}</p>
              <ul class="mt-4 space-y-2 text-sm leading-relaxed text-white/75">
                {p.items.map((item) => (
                  <li class="flex items-start gap-3">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-csk-amber"></span>
                    {item}
                  </li>
                ))}
              </ul>
              <a href={p.href} class="mt-5 inline-flex items-center text-xs font-semibold text-csk-amber underline-offset-4 hover:text-white hover:underline">
                Lihat layanan terkait <span aria-hidden="true" class="ml-2">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-csk-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-16 md:flex-row md:items-center md:justify-between md:py-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Mulai Konsultasi</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">Butuh estimasi biaya produksi?</h2>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-csk-gray sm:text-base">
          Kirimkan jenis kebutuhan, ukuran, jumlah, lokasi, dan target waktu. Tim CSK akan membantu membahas spesifikasi serta estimasi pengerjaan.
        </p>
      </div>
      <a href={waLink(serviceInquiryMessage)} target="_blank" rel="noopener"
         data-cta-location="services_final_cta"
         class="inline-flex min-h-12 shrink-0 items-center gap-2 rounded-sm bg-csk-amber px-7 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95">
        <WaIcon />Minta Penawaran
      </a>
    </div>
  </section>
</Base>
