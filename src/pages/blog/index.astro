---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('blog', ({ data }) => !data.draft);
articles.sort((a, b) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
  a.data.title.localeCompare(b.data.title, 'id')
);
const crumbs = [{ href: '/blog', label: 'Panduan' }];
---

<Base
  title="Panduan Produksi Booth, Display, POSM & Signage"
  description="Artikel CSK untuk menyiapkan proyek booth pameran, rak display retail, POSM, visual merchandising, dan signage. Panduan praktis dari brief hingga instalasi."
  breadcrumbs={crumbs}
>
  <Breadcrumbs items={crumbs} />

  <Section as="h1" eyebrow="Wawasan Produksi CSK"
           title="Panduan untuk Brand, Retail &amp; Event"
           lead="Bacaan praktis sebelum memesan booth, display, signage, dan material branding. Fokus pada keputusan produksi, bukan sekadar istilah pemasaran.">
    <div class="mt-8 flex flex-wrap gap-2" aria-label="Topik panduan">
      {['Booth & Pameran', 'Rak Display & Retail', 'POSM & Branding', 'Neon Box & Signage', 'Visual Merchandising'].map((category) => (
        <span class="rounded-full border border-csk-gray/20 bg-white px-4 py-2 text-xs font-medium text-csk-gray">{category}</span>
      ))}
    </div>
  </Section>

  <Section class="pt-0 md:pt-0">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((entry) => (
        <a href={`/blog/${entry.id}/`}
           class="group block overflow-hidden rounded-2xl border border-csk-gray/20 bg-white transition-shadow hover:shadow-lg">
          <div class="aspect-4/3 overflow-hidden bg-csk-gray/10">
            <img src={entry.data.image}
                 alt={entry.data.imageAlt || entry.data.title}
                 loading="lazy" decoding="async"
                 class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" />
          </div>
          <div class="p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-csk-amber-text">
              {entry.data.category || 'Panduan Produksi'}
            </p>
            <h2 class="mt-3 text-lg font-semibold leading-snug tracking-tight text-csk-black group-hover:text-csk-amber-text">
              {entry.data.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{entry.data.description}</p>
            <div class="mt-5 flex items-center justify-between gap-3 border-t border-csk-gray/15 pt-4 text-xs text-csk-gray">
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}
              </time>
              <span class="font-semibold text-csk-amber-text">Baca &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <section class="border-y border-csk-gray/15 bg-csk-gray/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-csk-black">Baru mengenal material promosi di toko?</h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-slate-600">
          Mulai dari istilah dasar sebelum memilih bentuk display untuk kampanye brand Anda.
        </p>
      </div>
      <a href="/apa-itu-posm/" class="inline-flex shrink-0 items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-csk-black ring-1 ring-csk-gray/20 hover:ring-csk-amber">
        Baca: Apa Itu POSM? &rarr;
      </a>
    </div>
  </section>

  <Section class="text-center">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Sudah siap masuk tahap produksi?</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">
      Lihat layanan yang sesuai kebutuhan proyek lalu kirim brief, ukuran, dan lokasi untuk diskusi penawaran.
    </p>
    <a href="/layanan/" class="mt-7 inline-flex items-center rounded-full bg-csk-black px-7 py-3 text-sm font-medium text-white hover:bg-csk-black/85">
      Jelajahi Layanan CSK &rarr;
    </a>
  </Section>
</Base>
