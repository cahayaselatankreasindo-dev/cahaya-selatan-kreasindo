---
import { render } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import WaIcon from '../components/WaIcon.astro';
import { serviceDetails, site, waLink } from '../site.js';

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = entry.data;
const slug = entry.id;
const service = serviceDetails.find((s) => s.slug === fm.service);
const images = import.meta.glob('/src/img/*.webp', { eager: true });
const cover = fm.cover ? images[`/src/img/${fm.cover}.webp`]?.default : null;
if (fm.cover && !cover) throw new Error(`Gambar blog tidak ditemukan: ${fm.cover}`);
const mainImage = cover?.src ?? fm.image ?? '/og-image.webp';
const articleUrl = new URL(`/blog/${slug}/`, Astro.site).href;
const crumbs = [
  { href: '/blog', label: 'Blog & Panduan' },
  { href: `/blog/${slug}/`, label: fm.title },
];
const dateLabel = (date) => new Intl.DateTimeFormat('id-ID', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta',
}).format(date);

const faq = fm.faq ?? [];
const faqSchema = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: fm.title,
  description: fm.description,
  datePublished: fm.pubDate.toISOString(),
  dateModified: (fm.updated ?? fm.pubDate).toISOString(),
  inLanguage: 'id-ID',
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  author: {
    '@type': 'Organization',
    name: fm.author || site.name,
    url: new URL('/tentang/', Astro.site).href,
  },
  image: new URL(mainImage, Astro.site).href,
  publisher: { '@id': new URL('/#business', Astro.site).href },
  ...(service && {
    about: {
      '@type': 'Service',
      name: service.title,
      url: new URL(`/layanan/${service.slug}/`, Astro.site).href,
    },
  }),
};
---
<Base title={fm.title} description={fm.description} image={mainImage} breadcrumbs={crumbs}>
  <Breadcrumbs items={crumbs} />
  <article class="mx-auto w-full max-w-5xl px-5 pt-12 md:pt-16">
    <header class="mx-auto max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-csk-amber-text">
        {fm.category || service?.nav || 'Panduan Produksi'}
      </p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-csk-black sm:text-4xl">{fm.title}</h1>
      <p class="mt-5 text-base leading-relaxed text-slate-600">{fm.description}</p>
      <p class="mt-5 text-sm text-csk-gray">
        Oleh <a href="/tentang/" class="font-medium text-csk-black underline underline-offset-2">{fm.author || site.name}</a>
        <span aria-hidden="true"> · </span>
        <time datetime={fm.pubDate.toISOString().slice(0, 10)}>{dateLabel(fm.pubDate)}</time>
        {fm.updated && <span> · Diperbarui {dateLabel(fm.updated)}</span>}
      </p>
    </header>

    {fm.cover && (
      <figure class="mx-auto mt-9 max-w-4xl overflow-hidden rounded-2xl border border-csk-gray/20 bg-csk-gray/10">
        <div class="aspect-[16/9] overflow-hidden">
          <Picture name={fm.cover} alt={fm.coverAlt || fm.title}
                   sizes="(min-width: 1024px) 880px, 95vw"
                   loading="eager" fetchpriority="high"
                   class="h-full w-full object-cover" />
        </div>
        <figcaption class="px-5 py-3 text-xs text-csk-gray">Dokumentasi proyek Cahaya Selatan Kreasindo</figcaption>
      </figure>
    )}

    <div class="prose prose-lg prose-slate prose-headings:tracking-tight prose-headings:text-csk-black prose-a:text-csk-amber-text prose-a:underline prose-p:leading-relaxed mx-auto mt-10 max-w-3xl">
      <Content />
    </div>

    {service && (
      <aside class="mx-auto mt-14 max-w-3xl rounded-2xl border border-csk-gray/20 bg-csk-gray/10 p-6 sm:p-8">
        <h2 class="text-xl font-semibold text-csk-black">Sedang menyiapkan proyek {service.nav.toLowerCase()}?</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          Kirim ukuran, lokasi, jadwal, dan gambaran kebutuhan. Tim CSK dapat membantu meninjau pilihan produksi dan instalasi berdasarkan brief.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`/layanan/${service.slug}/`}
             class="rounded-full border border-csk-gray/30 px-5 py-3 text-sm font-medium text-csk-black transition-colors hover:bg-white">
            Lihat layanan {service.nav}
          </a>
          <a href={waLink(`Halo CSK, saya membaca panduan "${fm.title}" dan ingin diskusi kebutuhan ${service.nav}.\n\nJenis proyek: \nLokasi: \nTarget pemasangan: `)}
             target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 rounded-full bg-csk-amber px-5 py-3 text-sm font-semibold text-csk-black transition-colors hover:bg-csk-amber/90">
            <WaIcon />Konsultasi WhatsApp
          </a>
        </div>
      </aside>
    )}

    <nav aria-label="Navigasi artikel" class="mx-auto mt-10 max-w-3xl">
      <a href="/blog/" class="text-sm font-semibold text-csk-amber-text hover:underline">← Semua panduan CSK</a>
    </nav>
  </article>

  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</Base>
