---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Picture from '../../components/Picture.astro';
import Lightbox from '../../components/Lightbox.astro';
import WaIcon from '../../components/WaIcon.astro';
import { waLink } from '../../site.js';

const breadcrumbs = [
  { href: '/portofolio/', label: 'Portofolio' },
  { href: '/portofolio/booth-512-slow-move-bazaar/', label: 'Booth Channel 512' },
];

const gallery = [
  {
    img: 'booth-512-slow-move-bazaar',
    alt: 'Tampilan depan booth custom Channel 512 di Slow Move Bazaar',
    caption: 'Tampilan utama booth',
    detail: 'Area booth 512 setelah selesai dipasang dan siap digunakan.',
  },
  {
    img: 'slow-move-bazaar-signage',
    alt: 'Detail signage dan identitas visual 512 pada booth',
    caption: 'Identitas brand',
    detail: 'Detail signage 512 dan elemen visual yang terlihat dari area bazaar.',
  },
  {
    img: 'slow-move-bazaar-booth-detail',
    alt: 'Detail area display dan interior booth Channel 512',
    caption: 'Detail area display',
    detail: 'Dokumentasi beberapa sudut booth dan area display.',
  },
  {
    img: 'slow-move-bazaar-event-activity',
    alt: 'Suasana pengunjung di area booth Channel 512',
    caption: 'Suasana event',
    detail: 'Booth hadir sebagai ruang brand selama kegiatan Slow Move Bazaar.',
  },
  {
    img: 'slow-move-bazaar-installation',
    alt: 'Tim melakukan pemasangan struktur booth di lokasi event',
    caption: 'Proses instalasi',
    detail: 'Dokumentasi pekerjaan pemasangan struktur di area event.',
  },
  {
    img: 'slow-move-bazaar-setup',
    alt: 'Proses penataan dan persiapan booth 512 di lokasi bazaar',
    caption: 'Persiapan di lokasi',
    detail: 'Tahap persiapan dan penataan sebelum booth digunakan.',
  },
];

const inquiryMessage = 'Halo CSK, saya melihat portofolio Booth Channel 512 di Slow Move Bazaar. Saya ingin konsultasi pembuatan booth custom untuk brand/event saya.\n\nNama brand: \nJenis event: \nUkuran area: \nLokasi: \nTanggal event: \nReferensi: ';
---

<Base
  title="Booth Channel 512 di Slow Move Bazaar"
  description="Dokumentasi proyek booth custom Cahaya Selatan Kreasindo bersama Channel 512 untuk Slow Move Bazaar. Lihat hasil akhir booth, detail display, suasana event, dan proses instalasi."
  image="/og-image.webp"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-36 -top-40 h-[30rem] w-[30rem] rotate-45 border border-csk-amber/15"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-[0.9fr_1.1fr] md:py-20 lg:gap-16 lg:px-8">
      <div class="relative z-10">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-csk-amber">Studi Kasus / Booth & Pameran</p>
        <h1 class="mt-6 max-w-2xl text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Booth Custom <span class="text-csk-amber">Channel 512.</span>
        </h1>
        <p class="mt-5 text-sm font-semibold uppercase tracking-[0.16em] text-white/65 sm:text-base">
          Slow Move Bazaar
        </p>
        <p class="mt-6 max-w-xl text-sm leading-7 text-white/70 sm:text-base">
          Dokumentasi proyek booth custom Cahaya Selatan Kreasindo bersama Channel 512. Halaman ini merangkum tampilan booth, detail area display, suasana event, serta proses pemasangan di lokasi.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={waLink(inquiryMessage)} target="_blank" rel="noopener"
             data-cta-location="portfolio_512_case_hero"
             class="inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-6 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-csk-amber">
            <WaIcon />Konsultasikan Booth
          </a>
          <a href="/portofolio/"
             class="inline-flex min-h-12 items-center border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-csk-amber hover:text-csk-amber">
            Kembali ke Portofolio
          </a>
        </div>
      </div>

      <figure class="relative z-10 overflow-hidden border border-white/10 bg-white/5">
        <Picture
          name="booth-512-slow-move-bazaar"
          alt="Tampilan depan booth custom Channel 512 di Slow Move Bazaar"
          loading="eager"
          fetchpriority="high"
          sizes="(min-width: 768px) 55vw, 100vw"
          class="aspect-[3/2] w-full object-cover"
        />
        <figcaption class="border-t border-white/10 px-4 py-3 text-xs font-medium uppercase tracking-[0.14em] text-white/60">
          Hasil produksi CSK · Slow Move Bazaar
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[1fr_0.8fr] md:py-20 lg:px-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Ringkasan Proyek</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">
        Ruang brand 512 di area bazaar.
      </h2>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-csk-gray sm:text-base">
        Booth ini menjadi ruang tampil Channel 512 selama Slow Move Bazaar. Dokumentasi memperlihatkan elemen identitas brand, area display, counter, pencahayaan, dan partisi yang membentuk area booth. Galeri juga menampilkan proses pemasangan serta suasana booth ketika event berlangsung.
      </p>
    </div>
    <dl class="grid grid-cols-1 gap-0 self-start border-y border-csk-gray/20">
      <div class="flex items-start justify-between gap-5 border-b border-csk-gray/15 py-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-csk-gray">Kolaborator</dt>
        <dd class="text-right text-sm font-bold text-csk-black">Channel 512</dd>
      </div>
      <div class="flex items-start justify-between gap-5 border-b border-csk-gray/15 py-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-csk-gray">Event</dt>
        <dd class="text-right text-sm font-bold text-csk-black">Slow Move Bazaar</dd>
      </div>
      <div class="flex items-start justify-between gap-5 py-4">
        <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-csk-gray">Pekerjaan</dt>
        <dd class="text-right text-sm font-bold text-csk-black">Booth custom & instalasi</dd>
      </div>
    </dl>
  </section>

  <section class="bg-[#f7f6f3]">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 md:py-20 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber-text">Galeri Proyek</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-csk-black sm:text-4xl">
            Hasil akhir, detail, dan proses.
          </h2>
        </div>
        <p class="max-w-sm text-sm leading-6 text-csk-gray">
          Pilih foto untuk melihat dokumentasi lebih dekat.
        </p>
      </div>

      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-lightbox>
        {gallery.map((item, index) => (
          <figure class="group overflow-hidden rounded-sm bg-white shadow-sm">
            <div class="overflow-hidden bg-csk-black">
              <button
                type="button"
                data-lightbox-trigger
                aria-label={`Buka foto: ${item.caption}`}
                class="block w-full focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-csk-amber"
              >
                <Picture
                  name={item.img}
                  alt={item.alt}
                  sizes="(min-width: 1024px) 370px, (min-width: 640px) 45vw, 95vw"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  class="aspect-[3/2] w-full cursor-zoom-in object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.035]"
                />
              </button>
            </div>
            <figcaption class="border-t border-csk-gray/10 px-4 py-4">
              <h3 class="text-sm font-bold text-csk-black">{item.caption}</h3>
              <p class="mt-1 text-xs leading-5 text-csk-gray">{item.detail}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-csk-black text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rotate-45 border border-csk-amber/20"></div>
    <div class="relative mx-auto max-w-5xl px-5 py-16 text-center md:py-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-csk-amber">Butuh Booth untuk Brand Anda?</p>
      <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
        Mari wujudkan ruang brand berikutnya bersama CSK.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-white/65 sm:text-base">
        Ceritakan konsep event, ukuran area, lokasi, dan tanggal pelaksanaan. Tim CSK siap membantu membahas kebutuhan booth custom Anda.
      </p>
      <a href={waLink(inquiryMessage)} target="_blank" rel="noopener"
         data-cta-location="portfolio_512_case_final"
         class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-sm bg-csk-amber px-7 py-3 text-sm font-bold text-csk-black transition-colors hover:brightness-95">
        <WaIcon />Diskusikan Proyek Anda
      </a>
    </div>
  </section>

  <Lightbox />
</Base>
